{
  "meta": {
    "name": "Siso design tokens",
    "version": "0.2",
    "date": "2026-11-13",
    "note": "Values match brand/tokens.css. Colours are the S-mobiili app's own palette: sampled from its App Store screenshots and read from s-pankki.fi design tokens. Only the dark-mode values marked in 04-colors.md are new."
  },
  "color": {
    "green": {
      "25": "#F7FCF7",
      "50": "#EBF7EC",
      "100": "#D2FCD5",
      "200": "#91FA9B",
      "300": "#99D59F",
      "500": "#00AA46",
      "700": "#007841",
      "900": "#004628",
      "bright": "#00EB5A"
    },
    "neutral": {
      "white": "#FFFFFF",
      "900": "#1F1F1F",
      "600": "#666666",
      "400": "#949494",
      "200": "#E6E6E6"
    },
    "signal": {
      "amber": { "bg": "#FFF1D8", "mark": "#CF8300", "text": "#885600", "meaning": "Streak and heads-up notes" },
      "info": { "bg": "#E0F4FF", "mark": "#00A1C5", "text": "#006E87", "meaning": "Explanations and tips" },
      "error": { "bg": "#FFEDED", "mark": "#B70000", "text": "#B70000", "meaning": "Failed actions and form errors only" }
    },
    "light": {
      "bg": "#EBF7EC",
      "surface": "#FFFFFF",
      "surfaceAlt": "#F7FCF7",
      "surfaceSelected": "#D2FCD5",
      "border": "#99D59F",
      "inputBorder": "#949494",
      "divider": "#E6E6E6",
      "text": "#004628",
      "textMuted": "#666666",
      "link": "#007841",
      "primaryFace": "#007841",
      "primaryEdge": "#004628",
      "primaryLabel": "#FFFFFF",
      "secondaryFace": "#FFFFFF",
      "secondaryEdge": "#99D59F",
      "secondaryLabel": "#004628",
      "onDarkFace": "#91FA9B",
      "onDarkEdge": "#00AA46",
      "onDarkLabel": "#004628",
      "progressTrack": "#D2FCD5",
      "progressFill": "#00AA46",
      "heroBg": "#004628",
      "heroNumber": "#91FA9B",
      "heroText": "#FFFFFF"
    },
    "dark": {
      "bg": "#00301B",
      "surface": "#004628",
      "surfaceSelected": "#1B6B43",
      "border": "#1B6B43",
      "text": "#F7FCF7",
      "textMuted": "#99D59F",
      "link": "#91FA9B",
      "primaryFace": "#91FA9B",
      "primaryEdge": "#00AA46",
      "primaryLabel": "#00301B",
      "progressTrack": "#1B6B43",
      "progressFill": "#91FA9B",
      "heroBg": "#004628",
      "heroNumber": "#91FA9B",
      "amber": "#FFC14D",
      "infoText": "#7FD9F2",
      "error": "#FF8A8A"
    },
    "basket": {
      "fixed": "#004628",
      "curveballs": "#007841",
      "leaks": "#00AA46",
      "jars": "#91FA9B",
      "note": "The darker the green, the more fixed the money. Jars are drawn with a 2px #00AA46 outline. Always add the icon and a label."
    }
  },
  "font": {
    "display": "Bricolage Grotesque",
    "text": "Figtree",
    "fallback": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
  },
  "type": {
    "heroXl": { "family": "display", "weight": 800, "size": 96, "lineHeight": 96 },
    "hero": { "family": "display", "weight": 800, "size": 64, "lineHeight": 68 },
    "display": { "family": "display", "weight": 800, "size": 40, "lineHeight": 44 },
    "h1": { "family": "display", "weight": 800, "size": 32, "lineHeight": 36 },
    "h2": { "family": "display", "weight": 700, "size": 24, "lineHeight": 28 },
    "h3": { "family": "text", "weight": 700, "size": 20, "lineHeight": 26 },
    "bodyLg": { "family": "text", "weight": 400, "size": 18, "lineHeight": 26 },
    "body": { "family": "text", "weight": 400, "size": 16, "lineHeight": 24 },
    "label": { "family": "text", "weight": 600, "size": 14, "lineHeight": 20 },
    "caption": { "family": "text", "weight": 600, "size": 12, "lineHeight": 16 },
    "button": { "family": "text", "weight": 700, "size": 17, "lineHeight": 24 },
    "amount": { "family": "text", "weight": 700, "size": 16, "lineHeight": 24, "numeric": "tabular-nums" }
  },
  "space": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "radius": { "xs": 6, "sm": 12, "md": 18, "lg": 24, "xl": 32, "full": 999 },
  "border": { "default": 2, "edge": 4, "sticker": 4 },
  "size": {
    "frame": [390, 844],
    "margin": 20,
    "touchMin": 48,
    "button": 56,
    "input": 56,
    "tabBar": 64,
    "topBar": 56,
    "chip": 32,
    "progress": 14,
    "avatarChat": 32
  },
  "motion": {
    "duration": { "press": 80, "fast": 150, "base": 250, "fill": 600, "celebrate": 1200 },
    "ease": {
      "out": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  }
}
