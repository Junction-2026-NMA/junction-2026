{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Setup worktree",
      "command": "sh scripts/t3-setup-worktree.sh",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Dev server",
      "command": "npm run dev",
      "icon": "play",
      "stopOnSettle": true,
      "previewUrl": "http://localhost:3000"
    },
    {
      "name": "Build check",
      "command": "npm run build",
      "icon": "build"
    },
    {
      "name": "Smoke test",
      "command": "npx playwright test",
      "icon": "test"
    }
  ]
}
