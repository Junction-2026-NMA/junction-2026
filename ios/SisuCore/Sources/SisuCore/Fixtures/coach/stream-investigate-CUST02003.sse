data: {"type":"stage","stage":{"kind":"action","title":"Switch electricity contract to Example Energia (Fixed 24)","summary":"Waiting for your approval. Nothing has been done.","source":"calculation","data":{"kind":"action","action":{"kind":"switch_contract","title":"Switch electricity contract to Example Energia (Fixed 24)","summary":"Estimated saving about €31 a year (€2.59 a month) against your current bill of €51.87 a month. Simulation only: Sisu does not contact the provider.","checklist":["Check when your current contract ends. A fixed-term contract usually cannot be ended early without a fee.","Find your metering point number on a recent electricity bill. The new seller needs it.","Order Fixed 24 from Example Energia on their own page, and check the price there first.","The new seller ends your old sales contract for you. Your grid (distribution) contract stays as it is.","A switch normally takes about two weeks, and an online order can be cancelled within 14 days."],"draftMessage":"Hello Example Energia,\n\nI would like to order Fixed 24 (24 months) as shown on your page.\nMetering point number: [from your electricity bill]\nPlease confirm the price and the start date before the contract begins.\n\nKind regards,\n[your name]","billType":"electricity","offer":{"provider":"Example Energia","plan":"Fixed 24","contractType":"fixed","contractMonths":24,"monthlyPriceEur":3.9,"energyPriceCentsPerKwh":8.9,"setupFeeEur":null,"sourceUrl":"https://example.com/mock-offers","comparable":true,"estimatedMonthlyCostEur":49.28,"estimatedYearlySavingEur":31.08},"monthlyAmountEur":2.59,"facts":[{"id":"action:current-bill","label":"Current bill per month","value":51.87,"unit":"EUR/month","source":"bank-data","basis":"average of the last 12 months; the bill's name is Sisu's guess","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"action:offer-monthly","label":"Example Energia, estimated cost per month","value":49.28,"unit":"EUR/month","source":"context.dev","basis":"price extracted from the provider's page, applied to your estimated use","url":"https://example.com/mock-offers"},{"id":"action:saving-yearly","label":"Estimated saving per year","value":31.08,"unit":"EUR/year","source":"calculation","basis":"current bill minus the offer's estimated cost, times 12"},{"id":"action:saving-monthly","label":"Estimated saving per month","value":2.59,"unit":"EUR/month","source":"calculation","basis":"yearly saving divided by 12"},{"id":"action:kwh","label":"Yearly electricity use in the estimate","value":6118,"unit":"kWh/year","source":"assumption","basis":"estimated from your bill"}],"sources":[{"title":"Mock offers (example data)","url":"https://example.com/mock-offers","retrievedAt":"2026-11-14T09:25:06.972Z","cacheAgeMs":null}],"assumptions":["Prices are as stated on the linked pages at the time shown. Check the provider's own page before switching.","Savings compare each offer with your average bill of €51.87 a month over the last 12 months.","The bank data has no payee names, so which bill this is rests on the name you confirmed.","Your electricity use is not in the bank data. We estimate about 6118 kWh a year from your bill, assuming you now pay today's typical fixed price (9.35 c/kWh). Tell Sisu your real yearly kWh, printed on your bill, for an exact figure.","If your bill also covers grid (distribution) fees, the real saving is smaller: those fees do not change when you switch seller.","Spot-price contracts are listed but not ranked, because their price changes every hour.","Switching steps are the usual ones in Finland. The provider's own terms decide."],"preparedBy":"sisu-agent","id":"90147852-21f7-4111-8771-0a0445787714","customerId":"CUST02003","status":"awaiting_approval","simulated":true,"createdAt":"2026-11-14T09:27:05.210Z","expiresAt":"2026-11-14T09:57:05.210Z","decidedAt":null,"impact":null}},"id":"c11de7d8-6cc4-4cee-bc2c-6422eee02a4d:6","toolCallId":"mock_prepare_action_ftzhd0","atMs":1263,"facts":[{"id":"action:current-bill","label":"Current bill per month","value":51.87,"unit":"EUR/month","source":"bank-data","basis":"average of the last 12 months; the bill's name is Sisu's guess","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"action:offer-monthly","label":"Example Energia, estimated cost per month","value":49.28,"unit":"EUR/month","source":"context.dev","basis":"price extracted from the provider's page, applied to your estimated use","url":"https://example.com/mock-offers"},{"id":"action:saving-yearly","label":"Estimated saving per year","value":31.08,"unit":"EUR/year","source":"calculation","basis":"current bill minus the offer's estimated cost, times 12"},{"id":"action:saving-monthly","label":"Estimated saving per month","value":2.59,"unit":"EUR/month","source":"calculation","basis":"yearly saving divided by 12"},{"id":"action:kwh","label":"Yearly electricity use in the estimate","value":6118,"unit":"kWh/year","source":"assumption","basis":"estimated from your bill"}]}}

data: {"type":"action","action":{"kind":"switch_contract","title":"Switch electricity contract to Example Energia (Fixed 24)","summary":"Estimated saving about €31 a year (€2.59 a month) against your current bill of €51.87 a month. Simulation only: Sisu does not contact the provider.","checklist":["Check when your current contract ends. A fixed-term contract usually cannot be ended early without a fee.","Find your metering point number on a recent electricity bill. The new seller needs it.","Order Fixed 24 from Example Energia on their own page, and check the price there first.","The new seller ends your old sales contract for you. Your grid (distribution) contract stays as it is.","A switch normally takes about two weeks, and an online order can be cancelled within 14 days."],"draftMessage":"Hello Example Energia,\n\nI would like to order Fixed 24 (24 months) as shown on your page.\nMetering point number: [from your electricity bill]\nPlease confirm the price and the start date before the contract begins.\n\nKind regards,\n[your name]","billType":"electricity","offer":{"provider":"Example Energia","plan":"Fixed 24","contractType":"fixed","contractMonths":24,"monthlyPriceEur":3.9,"energyPriceCentsPerKwh":8.9,"setupFeeEur":null,"sourceUrl":"https://example.com/mock-offers","comparable":true,"estimatedMonthlyCostEur":49.28,"estimatedYearlySavingEur":31.08},"monthlyAmountEur":2.59,"facts":[{"id":"action:current-bill","label":"Current bill per month","value":51.87,"unit":"EUR/month","source":"bank-data","basis":"average of the last 12 months; the bill's name is Sisu's guess","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"action:offer-monthly","label":"Example Energia, estimated cost per month","value":49.28,"unit":"EUR/month","source":"context.dev","basis":"price extracted from the provider's page, applied to your estimated use","url":"https://example.com/mock-offers"},{"id":"action:saving-yearly","label":"Estimated saving per year","value":31.08,"unit":"EUR/year","source":"calculation","basis":"current bill minus the offer's estimated cost, times 12"},{"id":"action:saving-monthly","label":"Estimated saving per month","value":2.59,"unit":"EUR/month","source":"calculation","basis":"yearly saving divided by 12"},{"id":"action:kwh","label":"Yearly electricity use in the estimate","value":6118,"unit":"kWh/year","source":"assumption","basis":"estimated from your bill"}],"sources":[{"title":"Mock offers (example data)","url":"https://example.com/mock-offers","retrievedAt":"2026-11-14T09:25:06.972Z","cacheAgeMs":null}],"assumptions":["Prices are as stated on the linked pages at the time shown. Check the provider's own page before switching.","Savings compare each offer with your average bill of €51.87 a month over the last 12 months.","The bank data has no payee names, so which bill this is rests on the name you confirmed.","Your electricity use is not in the bank data. We estimate about 6118 kWh a year from your bill, assuming you now pay today's typical fixed price (9.35 c/kWh). Tell Sisu your real yearly kWh, printed on your bill, for an exact figure.","If your bill also covers grid (distribution) fees, the real saving is smaller: those fees do not change when you switch seller.","Spot-price contracts are listed but not ranked, because their price changes every hour.","Switching steps are the usual ones in Finland. The provider's own terms decide."],"preparedBy":"sisu-agent","id":"90147852-21f7-4111-8771-0a0445787714","customerId":"CUST02003","status":"awaiting_approval","simulated":true,"createdAt":"2026-11-14T09:27:05.210Z","expiresAt":"2026-11-14T09:57:05.210Z","decidedAt":null,"impact":null}}

