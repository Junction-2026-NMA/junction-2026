data: {"type":"stage","stage":{"kind":"teaching","title":"Loyalty rarely pays","summary":"Your 3 monthly bills arrive one at a time. What do you think they add up to in a year?","source":"bank-data","facts":[{"id":"teach:switch:yearly","label":"Monthly bills, per year","value":1485.12,"unit":"EUR/year","source":"bank-data","basis":"3 recurring bills, 12-month average times 12","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"teach:switch:tenth","label":"A tenth of that","value":148.51,"unit":"EUR/year","source":"calculation","basis":"illustration only"}],"data":{"kind":"teaching","card":{"id":"switching-bills","concept":"switching-bills","title":"Loyalty rarely pays","explanation":"Providers usually keep their best prices for new customers. Checking the market once a year takes a few minutes, and a switch does not cut your service: the new provider handles the changeover.","question":"Your 3 monthly bills arrive one at a time. What do you think they add up to in a year?","reveal":"About €1,485 a year. A saving of even a tenth of that is €149 for one comparison.","facts":[{"id":"teach:switch:yearly","label":"Monthly bills, per year","value":1485.12,"unit":"EUR/year","source":"bank-data","basis":"3 recurring bills, 12-month average times 12","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"teach:switch:tenth","label":"A tenth of that","value":148.51,"unit":"EUR/year","source":"calculation","basis":"illustration only"}],"options":["About €1,485","About €743","About €2,525"],"correctIndex":0}},"id":"c11de7d8-6cc4-4cee-bc2c-6422eee02a4d:5","toolCallId":"mock_explain_concept_0p00ix","atMs":1009}}

data: {"type":"teaching","card":{"id":"switching-bills","concept":"switching-bills","title":"Loyalty rarely pays","explanation":"Providers usually keep their best prices for new customers. Checking the market once a year takes a few minutes, and a switch does not cut your service: the new provider handles the changeover.","question":"Your 3 monthly bills arrive one at a time. What do you think they add up to in a year?","reveal":"About €1,485 a year. A saving of even a tenth of that is €149 for one comparison.","facts":[{"id":"teach:switch:yearly","label":"Monthly bills, per year","value":1485.12,"unit":"EUR/year","source":"bank-data","basis":"3 recurring bills, 12-month average times 12","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"teach:switch:tenth","label":"A tenth of that","value":148.51,"unit":"EUR/year","source":"calculation","basis":"illustration only"}],"options":["About €1,485","About €743","About €2,525"],"correctIndex":0}}

