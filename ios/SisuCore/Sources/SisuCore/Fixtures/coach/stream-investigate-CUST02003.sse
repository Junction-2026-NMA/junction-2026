data: {"type":"grounding","grounding":{"ok":true,"checked":9,"unverified":[],"numbers":[{"value":53,"status":"receipt","factId":"small:count"},{"value":10,"status":"receipt","factId":"overview:category:Travel"},{"value":173,"status":"receipt","factId":"small:total"},{"value":49.28,"status":"receipt","factId":"offers:0:cost"},{"value":31.08,"status":"receipt","factId":"offers:0:saving"},{"value":51.87,"status":"receipt","factId":"utilities-1:monthly"},{"value":2.59,"status":"receipt","factId":"offers:0:saving-monthly"},{"value":155.4,"status":"receipt","factId":"scenario:gain"},{"value":3,"status":"receipt","factId":"last-month:Utilities:count"}],"corrections":[]},"facts":[{"id":"small:count","label":"Purchases under €10","value":53,"unit":"count","source":"bank-data","basis":"everyday-basket purchases in the last 12 months","evidence":{"from":"2025-10-01","to":"2026-09-30","basket":"everyday"}},{"id":"small:total","label":"Total of purchases under €10","value":172.58,"unit":"EUR/year","source":"bank-data","basis":"sum of those purchases","evidence":{"from":"2025-10-01","to":"2026-09-30","basket":"everyday"}},{"id":"utilities-1:monthly","label":"Electricity, average per month","value":51.87,"unit":"EUR/month","source":"bank-data","basis":"average of 12 payments in the last 12 months","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"utilities-1:yearly","label":"Electricity, per year","value":622.44,"unit":"EUR/year","source":"calculation","basis":"monthly average times 12","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"idle:runway","label":"Months of must-pay costs covered by the balance","value":25.11,"unit":"months","source":"calculation","basis":"balance divided by average must-pay costs"},{"id":"idle:above-buffer","label":"Balance above a six-month buffer","value":20672.45,"unit":"EUR","source":"calculation","basis":"balance minus 6 months of must-pay costs"},{"id":"utilities-2:monthly","label":"Home internet, average per month","value":40.32,"unit":"EUR/month","source":"bank-data","basis":"average of 12 payments in the last 12 months","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"utilities-2:yearly","label":"Home internet, per year","value":483.84,"unit":"EUR/year","source":"calculation","basis":"monthly average times 12","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"utilities-3:monthly","label":"Mobile plan, average per month","value":31.57,"unit":"EUR/month","source":"bank-data","basis":"average of 12 payments in the last 12 months","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"utilities-3:yearly","label":"Mobile plan, per year","value":378.84,"unit":"EUR/year","source":"calculation","basis":"monthly average times 12","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"offers:baseline","label":"Current bill per month","value":51.87,"unit":"EUR/month","source":"bank-data","basis":"average of the last 12 months"},{"id":"offers:kwh","label":"Yearly electricity use in the estimate","value":6118,"unit":"kWh/year","source":"assumption","basis":"estimated from the bill at today's typical price"},{"id":"offers:0:price","label":"Example Energia: energy price","value":8.9,"unit":"c/kWh","source":"context.dev","basis":"extracted from the provider's page","url":"https://example.com/mock-offers"},{"id":"offers:0:fee","label":"Example Energia: monthly price or fee","value":3.9,"unit":"EUR/month","source":"context.dev","basis":"extracted from the provider's page","url":"https://example.com/mock-offers"},{"id":"offers:0:term","label":"Example Energia: contract length","value":24,"unit":"months","source":"context.dev","basis":"extracted from the provider's page","url":"https://example.com/mock-offers"},{"id":"offers:0:cost","label":"Example Energia: estimated cost per month","value":49.28,"unit":"EUR/month","source":"calculation","basis":"extracted price applied to the estimated use","url":"https://example.com/mock-offers"},{"id":"offers:0:saving","label":"Example Energia: estimated saving per year","value":31.08,"unit":"EUR/year","source":"calculation","basis":"current bill minus estimated cost, times 12","url":"https://example.com/mock-offers"},{"id":"offers:0:saving-monthly","label":"Example Energia: estimated saving per month","value":2.59,"unit":"EUR/month","source":"calculation","basis":"yearly saving divided by 12","url":"https://example.com/mock-offers"},{"id":"offers:1:price","label":"Demo Sähkö: energy price","value":9.8,"unit":"c/kWh","source":"context.dev","basis":"extracted from the provider's page","url":"https://example.com/mock-offers"},{"id":"offers:1:fee","label":"Demo Sähkö: monthly price or fee","value":4.5,"unit":"EUR/month","source":"context.dev","basis":"extracted from the provider's page","url":"https://example.com/mock-offers"},{"id":"offers:1:term","label":"Demo Sähkö: contract length","value":12,"unit":"months","source":"context.dev","basis":"extracted from the provider's page","url":"https://example.com/mock-offers"},{"id":"offers:1:cost","label":"Demo Sähkö: estimated cost per month","value":54.46,"unit":"EUR/month","source":"calculation","basis":"extracted price applied to the estimated use","url":"https://example.com/mock-offers"},{"id":"offers:1:saving","label":"Demo Sähkö: estimated saving per year","value":-31.08,"unit":"EUR/year","source":"calculation","basis":"current bill minus estimated cost, times 12","url":"https://example.com/mock-offers"},{"id":"offers:1:saving-monthly","label":"Demo Sähkö: estimated saving per month","value":-2.59,"unit":"EUR/month","source":"calculation","basis":"yearly saving divided by 12","url":"https://example.com/mock-offers"},{"id":"scenario:freed","label":"Freed per month","value":2.59,"unit":"EUR/month","source":"calculation","basis":"bill saving plus the trimmed share of everyday spending"},{"id":"scenario:years","label":"Years ahead","value":5,"unit":"years","source":"customer-stated","basis":"the horizon asked for"},{"id":"scenario:gain","label":"Extra after the period if the money is kept","value":155.4,"unit":"EUR","source":"calculation","basis":"'keep the cash' minus 'change nothing'"},{"id":"scenario:nothing:end","label":"Change nothing: total at the end","value":115398.41,"unit":"EUR","source":"calculation","basis":"projected from 12-month averages"},{"id":"scenario:nothing:low","label":"Change nothing: low case","value":115398.41,"unit":"EUR","source":"calculation","basis":"1% a year scenario"},{"id":"scenario:nothing:high","label":"Change nothing: high case","value":115398.41,"unit":"EUR","source":"calculation","basis":"8% a year scenario"},{"id":"scenario:save:end","label":"Make the change, keep the cash: total at the end","value":115553.81,"unit":"EUR","source":"calculation","basis":"projected from 12-month averages"},{"id":"scenario:save:low","label":"Make the change, keep the cash: low case","value":115553.81,"unit":"EUR","source":"calculation","basis":"1% a year scenario"},{"id":"scenario:save:high","label":"Make the change, keep the cash: high case","value":115553.81,"unit":"EUR","source":"calculation","basis":"8% a year scenario"},{"id":"scenario:invest:end","label":"Make the change, invest it: total at the end","value":115574.35,"unit":"EUR","source":"calculation","basis":"projected from 12-month averages"},{"id":"scenario:invest:low","label":"Make the change, invest it: low case","value":115557.01,"unit":"EUR","source":"calculation","basis":"1% a year scenario"},{"id":"scenario:invest:high","label":"Make the change, invest it: high case","value":115588.96,"unit":"EUR","source":"calculation","basis":"8% a year scenario"},{"id":"action:current-bill","label":"Current bill per month","value":51.87,"unit":"EUR/month","source":"bank-data","basis":"average of the last 12 months; the bill's name is Sisu's guess","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"action:offer-monthly","label":"Example Energia, estimated cost per month","value":49.28,"unit":"EUR/month","source":"context.dev","basis":"price extracted from the provider's page, applied to your estimated use","url":"https://example.com/mock-offers"},{"id":"action:saving-yearly","label":"Estimated saving per year","value":31.08,"unit":"EUR/year","source":"calculation","basis":"current bill minus the offer's estimated cost, times 12"},{"id":"action:saving-monthly","label":"Estimated saving per month","value":2.59,"unit":"EUR/month","source":"calculation","basis":"yearly saving divided by 12"},{"id":"action:kwh","label":"Yearly electricity use in the estimate","value":6118,"unit":"kWh/year","source":"assumption","basis":"estimated from your bill"},{"id":"last-month:Utilities:count","label":"Utilities purchases in 2026-09","value":3,"unit":"count","source":"bank-data","basis":"number of transactions","evidence":{"from":"2026-09-01","to":"2026-09-30","category":"Utilities"}},{"id":"overview:category:Travel","label":"Travel, per month","value":8.65,"unit":"EUR/month","source":"bank-data","basis":"5 transactions, average of the last 12 months","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Travel"}}]}

data: {"type":"done","text":"Mock answer. The thing that stands out most: 53 purchases under €10 added up to €173 this year. Example Energia looks cheapest at about 49.28 euros a month, saving about 31.08 euros a year against your bill of 51.87 euros a month. These are example offers, not live prices. Keeping 2.59 euros a month adds up to about 155.4 euros over the period. I have prepared it for you to review. Nothing happens until you tap Approve, and even then it is a simulation. Providers usually keep their best prices for new customers. Checking the market once a year takes a few minutes, and a switch does not cut your service: the new provider handles the changeover. Your 3 monthly bills arrive one at a time. What do you think they add up to in a year?","citations":[{"title":"Mock offers (example data)","url":"https://example.com/mock-offers","retrievedAt":"2026-11-14T09:25:06.972Z","cacheAgeMs":null}],"timings":{"sttMs":null,"firstTokenMs":1289,"firstSentenceMs":1735,"totalMs":4848,"modelSteps":[{"model":"mock","provider":"mock","usedBackup":false,"firstTokenMs":250,"totalMs":250},{"model":"mock","provider":"mock","usedBackup":false,"firstTokenMs":250,"totalMs":250},{"model":"mock","provider":"mock","usedBackup":false,"firstTokenMs":250,"totalMs":250},{"model":"mock","provider":"mock","usedBackup":false,"firstTokenMs":250,"totalMs":250},{"model":"mock","provider":"mock","usedBackup":false,"firstTokenMs":250,"totalMs":250},{"model":"mock","provider":"mock","usedBackup":false,"firstTokenMs":26,"totalMs":3582}]}}

