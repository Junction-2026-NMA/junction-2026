data: {"type":"stage","stage":{"kind":"teaching","title":"Buffer before investing","summary":"How many months of your must-pay costs do you think your balance covers today?","source":"bank-data","facts":[{"id":"teach:buffer:runway","label":"Months of must-pay costs covered","value":25.11,"unit":"months","source":"calculation","basis":"balance divided by average must-pay costs"},{"id":"teach:buffer:mandatory","label":"Must-pay costs per month","value":1081.56,"unit":"EUR/month","source":"bank-data","basis":"regular plus now-and-then baskets, 12-month average","evidence":{"from":"2025-10-01","to":"2026-09-30"}},{"id":"teach:buffer:target","label":"Three-month buffer","value":3244.68,"unit":"EUR","source":"calculation","basis":"three times monthly must-pay costs"},{"id":"teach:buffer:balance","label":"Balance","value":27161.81,"unit":"EUR","source":"bank-data","basis":"account balance on 2026-09-30"}],"data":{"kind":"teaching","card":{"id":"buffer-first","concept":"buffer-first","title":"Buffer before investing","explanation":"A buffer is cash that covers your must-pay costs if income stops or a large bill lands. A common rule of thumb is three to six months. Without one, a surprise cost has to come from credit, which costs more than most investments earn.","question":"How many months of your must-pay costs do you think your balance covers today?","reveal":"About 25.11 months. Your must-pay costs average €1,082 a month, so a three-month buffer would be €3,245; your balance is €27,162.","facts":[{"id":"teach:buffer:runway","label":"Months of must-pay costs covered","value":25.11,"unit":"months","source":"calculation","basis":"balance divided by average must-pay costs"},{"id":"teach:buffer:mandatory","label":"Must-pay costs per month","value":1081.56,"unit":"EUR/month","source":"bank-data","basis":"regular plus now-and-then baskets, 12-month average","evidence":{"from":"2025-10-01","to":"2026-09-30"}},{"id":"teach:buffer:target","label":"Three-month buffer","value":3244.68,"unit":"EUR","source":"calculation","basis":"three times monthly must-pay costs"},{"id":"teach:buffer:balance","label":"Balance","value":27161.81,"unit":"EUR","source":"bank-data","basis":"account balance on 2026-09-30"}],"options":["About 63.78 months","About 16.04 months","About 25.11 months"],"correctIndex":2}},"id":"055900ec-ba63-4295-9da6-0a31671b9add:0","toolCallId":"mock_explain_concept_bbtbk3","atMs":253}}

