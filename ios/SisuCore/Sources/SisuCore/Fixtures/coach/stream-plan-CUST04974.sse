m/mock-source","retrievedAt":"2026-11-14T11:30:03.669Z","cacheAgeMs":null}],"tookMs":0,"mock":true},{"id":"housing-cost","title":"Is your housing cost normal for Helsinki?","query":"typical monthly rent for a one-room apartment in Helsinki 2026","yours":{"label":"Your housing payment","value":661.7,"unit":"EUR/month"},"ok":true,"finding":"Example finding. In mock mode no search is made, so there is nothing real to report here.","figuresConfirmed":false,"sources":[{"title":"Mock source (example data)","url":"https://example.com/mock-source","retrievedAt":"2026-11-14T11:30:03.669Z","cacheAgeMs":null}],"tookMs":0,"mock":true}],"actions":[{"kind":"switch_contract","title":"Switch electricity contract to Example Energia (Fixed 24)","summary":"Estimated saving about €24 a year (€2.01 a month) against your current bill of €39.83 a month. Simulation only: Sisu does not contact the provider.","checklist":["Check when your current contract ends. A fixed-term contract usually cannot be ended early without a fee.","Find your metering point number on a recent electricity bill. The new seller needs it.","Order Fixed 24 from Example Energia on their own page, and check the price there first.","The new seller ends your old sales contract for you. Your grid (distribution) contract stays as it is.","A switch normally takes about two weeks, and an online order can be cancelled within 14 days."],"draftMessage":"Hello Example Energia,\n\nI would like to order Fixed 24 (24 months) as shown on your page.\nMetering point number: [from your electricity bill]\nPlease confirm the price and the start date before the contract begins.\n\nKind regards,\n[your name]","billType":"electricity","offer":{"provider":"Example Energia","plan":"Fixed 24","contractType":"fixed","contractMonths":24,"monthlyPriceEur":3.9,"energyPriceCentsPerKwh":8.9,"setupFeeEur":null,"sourceUrl":"https://example.com/mock-offers","comparable":true,"estimatedMonthlyCostEur":37.82,"estimatedYearlySavingEur":24.12},"monthlyAmountEur":2.01,"facts":[{"id":"action:current-bill","label":"Current bill per month","value":39.83,"unit":"EUR/month","source":"bank-data","basis":"average of the last 12 months; the bill's name is Sisu's guess","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"action:offer-monthly","label":"Example Energia, estimated cost per month","value":37.82,"unit":"EUR/month","source":"context.dev","basis":"price extracted from the provider's page, applied to your estimated use","url":"https://example.com/mock-offers"},{"id":"action:saving-yearly","label":"Estimated saving per year","value":24.12,"unit":"EUR/year","source":"calculation","basis":"current bill minus the offer's estimated cost, times 12"},{"id":"action:saving-monthly","label":"Estimated saving per month","value":2.01,"unit":"EUR/month","source":"calculation","basis":"yearly saving divided by 12"},{"id":"action:kwh","label":"Yearly electricity use in the estimate","value":4573,"unit":"kWh/year","source":"assumption","basis":"estimated from your bill"}],"sources":[{"title":"Mock offers (example data)","url":"https://example.com/mock-offers","retrievedAt":"2026-11-14T11:30:04.569Z","cacheAgeMs":null}],"assumptions":["Prices are as stated on the linked pages at the time shown. Check the provider's own page before switching.","Savings compare each offer with your average bill of €39.83 a month over the last 12 months.","The bank data has no payee names, so which bill this is rests on the name you confirmed.","Your electricity use is not in the bank data. We estimate about 4573 kWh a year from your bill, assuming you now pay today's typical fixed price (9.35 c/kWh). Tell Sisu your real yearly kWh, printed on your bill, for an exact figure.","If your bill also covers grid (distribution) fees, the real saving is smaller: those fees do not change when you switch seller.","Spot-price contracts are listed but not ranked, because their price changes every hour.","Switching steps are the usual ones in Finland. The provider's own terms decide."],"preparedBy":"sisu-agent","id":"dca125ba-7f9e-434c-a05e-6cb03ee200d3","customerId":"CUST04974","status":"awaiting_approval","simulated":true,"createdAt":"2026-11-14T11:30:04.583Z","expiresAt":"2026-11-14T12:00:04.583Z","decidedAt":null,"impact":null},{"kind":"switch_contract","title":"Switch home internet contract to Example Tel (Basic)","summary":"Estimated saving about €150 a year (€12.46 a month) against your current bill of €30.36 a month. Simulation only: Sisu does not contact the provider.","checklist":["Check your current contract's notice period, and whether your building already has a shared connection.","Check that Example Tel delivers Basic at your address.","Order the new connection first, then end the old one once the new one works.","An online order can be cancelled within 14 days."],"draftMessage":"Hello Example Tel,\n\nI would like to order Basic (12 months) as shown on your page.\nCurrent number or address: [fill in]\nPlease confirm the price and the start date before the contract begins.\n\nKind regards,\n[your name]","billType":"internet","offer":{"provider":"Example Tel","plan":"Basic","contractType":"fixed","contractMonths":12,"monthlyPriceEur":17.9,"energyPriceCentsPerKwh":null,"setupFeeEur":0,"sourceUrl":"https://example.com/mock-offers","comparable":true,"estimatedMonthlyCostEur":17.9,"estimatedYearlySavingEur":149.52},"monthlyAmountEur":12.46,"facts":[{"id":"action:current-bill","label":"Current bill per month","value":30.36,"unit":"EUR/month","source":"bank-data","basis":"average of the last 12 months; the bill's name is Sisu's guess","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"action:offer-monthly","label":"Example Tel, estimated cost per month","value":17.9,"unit":"EUR/month","source":"context.dev","basis":"price extracted from the provider's page, applied to your estimated use","url":"https://example.com/mock-offers"},{"id":"action:saving-yearly","lab