ce":"context.dev","basis":"extracted from the provider's page","url":"https://example.com/mock-offers"},{"id":"offers:0:fee","label":"Example Energia: monthly price or fee","value":3.9,"unit":"EUR/month","source":"context.dev","basis":"extracted from the provider's page","url":"https://example.com/mock-offers"},{"id":"offers:0:term","label":"Example Energia: contract length","value":24,"unit":"months","source":"context.dev","basis":"extracted from the provider's page","url":"https://example.com/mock-offers"},{"id":"offers:0:cost","label":"Example Energia: estimated cost per month","value":37.82,"unit":"EUR/month","source":"calculation","basis":"extracted price applied to the estimated use","url":"https://example.com/mock-offers"},{"id":"offers:0:saving","label":"Example Energia: estimated saving per year","value":24.12,"unit":"EUR/year","source":"calculation","basis":"current bill minus estimated cost, times 12","url":"https://example.com/mock-offers"},{"id":"offers:0:saving-monthly","label":"Example Energia: estimated saving per month","value":2.01,"unit":"EUR/month","source":"calculation","basis":"yearly saving divided by 12","url":"https://example.com/mock-offers"},{"id":"offers:1:price","label":"Demo Sähkö: energy price","value":9.8,"unit":"c/kWh","source":"context.dev","basis":"extracted from the provider's page","url":"https://example.com/mock-offers"},{"id":"offers:1:fee","label":"Demo Sähkö: monthly price or fee","value":4.5,"unit":"EUR/month","source":"context.dev","basis":"extracted from the provider's page","url":"https://example.com/mock-offers"},{"id":"offers:1:term","label":"Demo Sähkö: contract length","value":12,"unit":"months","source":"context.dev","basis":"extracted from the provider's page","url":"https://example.com/mock-offers"},{"id":"offers:1:cost","label":"Demo Sähkö: estimated cost per month","value":41.85,"unit":"EUR/month","source":"calculation","basis":"extracted price applied to the estimated use","url":"https://example.com/mock-offers"},{"id":"offers:1:saving","label":"Demo Sähkö: estimated saving per year","value":-24.24,"unit":"EUR/year","source":"calculation","basis":"current bill minus estimated cost, times 12","url":"https://example.com/mock-offers"},{"id":"offers:1:saving-monthly","label":"Demo Sähkö: estimated saving per month","value":-2.02,"unit":"EUR/month","source":"calculation","basis":"yearly saving divided by 12","url":"https://example.com/mock-offers"},{"id":"scenario:freed","label":"Freed per month","value":2.01,"unit":"EUR/month","source":"calculation","basis":"bill saving plus the trimmed share of everyday spending"},{"id":"scenario:years","label":"Years ahead","value":5,"unit":"years","source":"customer-stated","basis":"the horizon asked for"},{"id":"scenario:gain","label":"Extra after the period if the money is kept","value":120.6,"unit":"EUR","source":"calculation","basis":"'keep the cash' minus 'change nothing'"},{"id":"scenario:nothing:end","label":"Change nothing: total at the end","value":490.75,"unit":"EUR","source":"calculation","basis":"projected from 12-month averages"},{"id":"scenario:nothing:low","label":"Change nothing: low case","value":490.75,"unit":"EUR","source":"calculation","basis":"1% a year scenario"},{"id":"scenario:nothing:high","label":"Change nothing: high case","value":490.75,"unit":"EUR","source":"calculation","basis":"8% a year scenario"},{"id":"scenario:save:end","label":"Make the change, keep the cash: total at the end","value":611.35,"unit":"EUR","source":"calculation","basis":"projected from 12-month averages"},{"id":"scenario:save:low","label":"Make the change, keep the cash: low case","value":611.35,"unit":"EUR","source":"calculation","basis":"1% a year scenario"},{"id":"scenario:save:high","label":"Make the change, keep the cash: high case","value":611.35,"unit":"EUR","source":"calculation","basis":"8% a year scenario"},{"id":"scenario:invest:end","label":"Make the change, invest it: total at the end","value":627.29,"unit":"EUR","source":"calculation","basis":"projected from 12-month averages"},{"id":"scenario:invest:low","label":"Make the change, invest it: low case","value":613.83,"unit":"EUR","source":"calculation","basis":"1% a year scenario"},{"id":"scenario:invest:high","label":"Make the change, invest it: high case","value":638.63,"unit":"EUR","source":"calculation","basis":"8% a year scenario"},{"id":"action:current-bill","label":"Current bill per month","value":39.83,"unit":"EUR/month","source":"bank-data","basis":"average of the last 12 months; the bill's name is Sisu's guess","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"action:offer-monthly","label":"Example Energia, estimated cost per month","value":37.82,"unit":"EUR/month","source":"context.dev","basis":"price extracted from the provider's page, applied to your estimated use","url":"https://example.com/mock-offers"},{"id":"action:saving-yearly","label":"Estimated saving per year","value":24.12,"unit":"EUR/year","source":"calculation","basis":"current bill minus the offer's estimated cost, times 12"},{"id":"action:saving-monthly","label":"Estimated saving per month","value":2.01,"unit":"EUR/month","source":"calculation","basis":"yearly saving divided by 12"},{"id":"action:kwh","label":"Yearly electricity use in the estimate","value":4573,"unit":"kWh/year","source":"assumption","basis":"estimated from your bill"},{"id":"last-month:Utilities:count","label":"Utilities purchases in 2026-09","value":3,"unit":"count","source":"bank-data","basis":"number of transactions","evidence":{"from":"2026-09-01","to":"2026-09-30","category":"Utilities"}}]}

data: {"type":"done","text":"Mock answer. The thing that stands out most: Entertainment is up 65% on a year ago. Example Energia looks cheapest at about 37.82 euros a month, saving about 24.12 euros a year against your bill of 39.83 euros a month. These are example offers, not live prices. Keeping 2.01 euros a month adds up to about 120.6 euros over the period. I have prepared it for you to review. Nothing happens until you tap Approve, and even then it is a simulation. Providers usually keep their best prices for new customers. Checking the market once a year takes a few minutes, and a switch does not cut your service: the new provider handles the changeover. Your 3 monthly bills arrive one at a time. What do you think they add up to in a year?","citations":[{"title":"Mock offers (example data)","url":"https://example.com/mock-offers","retrievedAt":"2026-11-14T11:27:30.317Z","cacheAgeMs":null}],"timings":{"sttMs":null,"firstTokenMs":1296,"firstSentenceMs":1689,"totalMs":4813,"modelSteps":[{"model":"mock","provider":"mock","usedBackup":false,"firstTokenMs":250,"totalMs":250},{"model":"mock","provider":"mock","usedBackup":false,"firstTokenMs":250,"totalMs":250},{"model":"mock","provider":"mock","usedBackup":false,"firstTokenMs":250,"totalMs":250},{"model":"mock","provider":"mock","usedBackup":false,"firstTokenMs":250,"totalMs":250},{"model":"mock","provider":"mock","usedBackup":false,"firstTokenMs":250,"totalMs":250},{"model":"mock","provider":"mock","usedBackup":false,"firstTokenMs":26,"totalMs":3542}]}}

