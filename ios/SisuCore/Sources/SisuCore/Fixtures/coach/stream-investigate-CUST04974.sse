data: {"type":"stage","stage":{"kind":"teaching","title":"Loyalty rarely pays","summary":"Your 3 monthly bills arrive one at a time. What do you think they add up to in a year?","source":"bank-data","facts":[{"id":"teach:switch:yearly","label":"Monthly bills, per year","value":1140.24,"unit":"EUR/year","source":"bank-data","basis":"3 recurring bills, 12-month average times 12","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"teach:switch:tenth","label":"A tenth of that","value":114.02,"unit":"EUR/year","source":"calculation","basis":"illustration only"}],"data":{"kind":"teaching","card":{"id":"switching-bills","concept":"switching-bills","title":"Loyalty rarely pays","explanation":"Providers usually keep their best prices for new customers. Checking the market once a year takes a few minutes, and a switch does not cut your service: the new provider handles the changeover.","question":"Your 3 monthly bills arrive one at a time. What do you think they add up to in a year?","reveal":"About €1,140 a year. A saving of even a tenth of that is €114 for one comparison.","facts":[{"id":"teach:switch:yearly","label":"Monthly bills, per year","value":1140.24,"unit":"EUR/year","source":"bank-data","basis":"3 recurring bills, 12-month average times 12","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"teach:switch:tenth","label":"A tenth of that","value":114.02,"unit":"EUR/year","source":"calculation","basis":"illustration only"}],"options":["About €1,140","About €570","About €1,938"],"correctIndex":0}},"id":"71c02f42-6e6c-4014-af86-4fb049e61e86:5","toolCallId":"mock_explain_concept_3t6doz","atMs":1016}}

data: {"type":"teaching","card":{"id":"switching-bills","concept":"switching-bills","title":"Loyalty rarely pays","explanation":"Providers usually keep their best prices for new customers. Checking the market once a year takes a few minutes, and a switch does not cut your service: the new provider handles the changeover.","question":"Your 3 monthly bills arrive one at a time. What do you think they add up to in a year?","reveal":"About €1,140 a year. A saving of even a tenth of that is €114 for one comparison.","facts":[{"id":"teach:switch:yearly","label":"Monthly bills, per year","value":1140.24,"unit":"EUR/year","source":"bank-data","basis":"3 recurring bills, 12-month average times 12","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"teach:switch:tenth","label":"A tenth of that","value":114.02,"unit":"EUR/year","source":"calculation","basis":"illustration only"}],"options":["About €1,140","About €570","About €1,938"],"correctIndex":0}}

