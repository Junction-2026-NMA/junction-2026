data: {"type":"visual","visual":{"id":"budget","kind":"budget_donut","title":"Where your money goes in an average month","caption":"Average of the last 12 months, Oct 25 to Sep 26","summary":"All spending averages €1,795 a month. The largest part is Housing at €662, then Groceries at €289 and Restaurants at €277.","source":"bank-data","facts":[{"id":"chart:budget:Housing","label":"Housing, average per month","value":661.7,"unit":"EUR/month","source":"bank-data","basis":"Average of the last 12 months, Oct 25 to Sep 26","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Housing"}},{"id":"chart:budget:Groceries","label":"Groceries, average per month","value":288.9,"unit":"EUR/month","source":"bank-data","basis":"Average of the last 12 months, Oct 25 to Sep 26","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Groceries"}},{"id":"chart:budget:Restaurants","label":"Restaurants, average per month","value":276.52,"unit":"EUR/month","source":"bank-data","basis":"Average of the last 12 months, Oct 25 to Sep 26","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Restaurants"}},{"id":"chart:budget:Home & Tech","label":"Home & Tech, average per month","value":267.12,"unit":"EUR/month","source":"bank-data","basis":"Average of the last 12 months, Oct 25 to Sep 26","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Home & Tech"}},{"id":"chart:budget:Entertainment","label":"Entertainment, average per month","value":157.79,"unit":"EUR/month","source":"bank-data","basis":"Average of the last 12 months, Oct 25 to Sep 26","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Entertainment"}},{"id":"chart:budget:Other","label":"Other, average per month","value":143.46,"unit":"EUR/month","source":"bank-data","basis":"Average of the last 12 months, Oct 25 to Sep 26"},{"id":"chart:budget:total","label":"All spending, average per month","value":1795.49,"unit":"EUR/month","source":"calculation","basis":"the sum of the categories"}],"slices