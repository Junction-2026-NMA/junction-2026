data: {"type":"stage","stage":{"kind":"action","title":"Switch electricity contract to Example Energia (Fixed 24)","summary":"Set up and waiting for your tap on Approve.","source":"calculation","data":{"kind":"action","action":{"kind":"switch_contract","title":"Switch electricity contract to Example Energia (Fixed 24)","summary":"Estimated saving about €24 a year (€2.01 a month) against your current bill of €39.83 a month. Simulation only: Sisu does not contact the provider.","checklist":["Check when your current contract ends. A fixed-term contract usually cannot be ended early without a fee.","Find your metering point number on a recent electricity bill. The new seller needs it.","Order Fixed 24 from Example Energia on their own page, and check the price there first.","The new seller ends your old sales contract for you. Your grid (distribution) contract stays as it is.","A switch normally takes about two weeks, and an online order can be cancelled within 14 days."],"draftMessage":"Hello Example Energia,\n\nI would like to order Fixed 24 (24 months) as shown on your page.\nMetering point number: [from your electricity bill]\nPlease confirm the price and the start date before the contract begins.\n\nKind regards,\n[your name]","billType":"electricity","offer":{"provider":"Example Energia","plan":"Fixed 24","contractType":"fixed","contractMonths":24,"monthlyPriceEur":3.9,"energyPriceCentsPerKwh":8.9,"setupFeeEur":null,"sourceUrl":"https://example.com/mock-offers","comparable":true,"estimatedMonthlyCostEur":37.82,"estimatedYearlySavingEur":24.12},"monthlyAmountEur":2.01,"facts":[{"id":"action:current-bill","label":"Current bill per month","value":39.83,"unit":"EUR/month","source":"bank-data","basis":"average of the last 12 months; the bill's name is Sisu's guess","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"action:offer-monthly","label":"Example Energia, estimated cost per month","value":37.82,"unit":"EUR/month","source":"context.dev","basis":"price extracted from the provider's page, applied to your estimated use","url":"https://example.com/mock-offers"},{"id":"action:saving-yearly","label":"Estimated saving per year","value":24.12,"unit":"EUR/year","source":"calculation","basis":"current bill minus the offer's estimated cost, times 12"},{"id":"action:saving-monthly","label":"Estimated saving per month","value":2.01,"unit":"EUR/month","source":"calculation","basis":"yearly saving divided by 12"},{"id":"action:kwh","label":"Yearly electricity use in the estimate","value":4573,"unit":"kWh/year","source":"assumption","basis":"estimated from your bill"}],"sources":[{"title":"Mock offers (example data)","url":"https://example.com/mock-offers","retrievedAt":"2026-11-14T11:27:30.317Z","cacheAgeMs":null}],"assumptions":["Prices are as stated on the linked pages at the time shown. Check the provider's own page before switching.","Savings compare each offer with your average bill of €39.83 a month over the last 12 months.","The bank data has no payee names, so which bill this is rests on the name you confirmed.","Your electricity use is not in the bank data. We estimate about 4573 kWh a year from your bill, assuming you now pay today's typical fixed price (9.35 c/kWh). Tell Sisu your real yearly kWh, printed on your bill, for an exact figure.","If your bill also covers grid (distribution) fees, the real saving is smaller: those fees do not change when you switch seller.","Spot-price contracts are listed but not ranked, because their price changes every hour.","Switching steps are the usual ones in Finland. The provider's own terms decide."],"preparedBy":"sisu-agent","id":"cf88bd68-b3f6-45ad-aa6a-2dc0249f8c4b","customerId":"CUST04974","status":"awaiting_approval","simulated":true,"createdAt":"2026-11-14T11:29:22.725Z","expiresAt":"2026-11-14T11:59:22.725Z","decidedAt":null,"impact":null}},"id":"71c02f42-6e6c-4014-af86-4fb049e61e86:6","toolCallId":"mock_prepare_action_m7l3xv","atMs":1270,"facts":[{"id":"action:current-bill","label":"Current bill per month","value":39.83,"unit":"EUR/month","source":"bank-data","basis":"average of the last 12 months; the bill's name is Sisu's guess","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"action:offer-monthly","label":"Example Energia, estimated cost per month","value":37.82,"unit":"EUR/month","source":"context.dev","basis":"price extracted from the provider's page, applied to your estimated use","url":"https://example.com/mock-offers"},{"id":"action:saving-yearly","label":"Estimated saving per year","value":24.12,"unit":"EUR/year","source":"calculation","basis":"current bill minus the offer's estimated cost, times 12"},{"id":"action:saving-monthly","label":"Estimated saving per month","value":2.01,"unit":"EUR/month","source":"calculation","basis":"yearly saving divided by 12"},{"id":"action:kwh","label":"Yearly electricity use in the estimate","value":4573,"unit":"kWh/year","source":"assumption","basis":"estimated from your bill"}]}}

data: {"type":"action","action":{"kind":"switch_contract","title":"Switch electricity contract to Example Energia (Fixed 24)","summary":"Estimated saving about €24 a year (€2.01 a month) against your current bill of €39.83 a month. Simulation only: Sisu does not contact the provider.","checklist":["Check when your current contract ends. A fixed-term contract usually cannot be ended early without a fee.","Find your metering point number on a recent electricity bill. The new seller needs it.","Order Fixed 24 from Example Energia on their own page, and check the price there first.","The new seller ends your old sales contract for you. Your grid (distribution) contract stays as it is.","A switch normally takes about two weeks, and an online order can be cancelled within 14 days."],"draftMessage":"Hello Example Energia,\n\nI would like to order Fixed 24 (24 months) as shown on your page.\nMetering point number: [from your electricity bill]\nPlease confirm the price and the start date before the contract begins.\n\nKind regards,\n[your name]","billType":"electricity","offer":{"provider":"Example Energia","plan":"Fixed 24","contractType":"fixed","contractMonths":24,"monthlyPriceEur":3.9,"energyPriceCentsPerKwh":8.9,"setupFeeEur":null,"sourceUrl":"https://example.com/mock-offers","comparable":true,"estimatedMonthlyCostEur":37.82,"estimatedYearlySavingEur":24.12},"monthlyAmountEur":2.01,"facts":[{"id":"action:current-bill","label":"Current bill per month","value":39.83,"unit":"EUR/month","source":"bank-data","basis":"average of the last 12 months; the bill's name is Sisu's guess","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Utilities"}},{"id":"action:offer-monthly","label":"Example Energia, estimated cost per month","value":37.82,"unit":"EUR/month","source":"context.dev","basis":"price extracted from the provider's page, applied to your estimated use","url":"https://example.com/mock-offers"},{"id":"action:saving-yearly","label":"Estimated saving per year","value":24.12,"unit":"EUR/year","source":"calculation","basis":"current bill minus the offer's estimated cost, times 12"},{"id":"action:saving-monthly","label":"Estimated saving per month","value":2.01,"unit":"EUR/month","source":"calculation","basis":"yearly saving divided by 12"},{"id":"action:kwh","label":"Yearly electricity use in the estimate","value":4573,"unit":"kWh/year","source":"assumption","basis":"estimated from your bill"}],"sources":[{"title":"Mock offers (example data)","url":"https://example.com/mock-offers","retrievedAt":"2026-11-14T11:27:30.317Z","cacheAgeMs":null}],"assumptions":["Prices are as stated on the linked pages at the time shown. Check the provider's own page before switching.","Savings compare each offer with your average bill of €39.83 a month over the last 12 months.","The bank data has no payee names, so which bill this is rests on the name you confirmed.","Your electricity use is not in the bank data. We estimate about 4573 kWh a year from your bill, assuming you now pay today's typical fixed price (9.35 c/kWh). Tell Sisu your real yearly kWh, printed on your bill, for an exact figure.","If your bill also covers grid (distribution) fees, the real saving is smaller: those fees do not change when you switch seller.","Spot-price contracts are listed but not ranked, because their price changes every hour.","Switching steps are the usual ones in Finland. The provider's own terms decide."],"preparedBy":"sisu-agent","id":"cf88bd68-b3f6-45ad-aa6a-2dc0249f8c4b","customerId":"CUST04974","status":"awaiting_approval","simulated":true,"createdAt":"2026-11-14T11:29:22.725Z","expiresAt":"2026-11-14T11:59:22.725Z","decidedAt":null,"impact":null}}

