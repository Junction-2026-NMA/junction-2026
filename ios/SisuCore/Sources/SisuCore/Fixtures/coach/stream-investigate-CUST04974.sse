data: {"type":"stage","stage":{"kind":"lead","title":"What Sisu noticed","summary":"Entertainment is up 65% on a year ago","source":"bank-data","data":{"kind":"lead","patterns":[{"id":"category-drift:Entertainment","kind":"category-drift","title":"Entertainment is up 65% on a year ago","detail":"You averaged €96 a month on Entertainment the year before and €158 a month in the last 12 months: €746 more a year.","yearlyImpactEur":746.16,"confidence":"high","billType":null,"evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Entertainment"},"facts":[{"id":"drift:Entertainment:now","label":"Entertainment, per month now","value":157.79,"unit":"EUR/month","source":"bank-data","basis":"last 12 months","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Entertainment"}},{"id":"drift:Entertainment:before","label":"Entertainment, per month a year earlier","value":95.61,"unit":"EUR/month","source":"bank-data","basis":"the 12 months before","evidence":{"from":"2024-10-01","to":"2025-09-30","category":"Entertainment"}},{"id":"drift:Entertainment:extra","label":"Entertainment, extra per year","value":746.16,"unit":"EUR/year","source":"calculation","basis":"difference times 12"}],"nextSteps":["get_spending","run_scenario"]},{"id":"peer-gap:Restaurants","kind":"peer-gap","title":"Restaurants: €64 a month above people your age","detail":"You average €277 a month; the 419 customers aged 18-24 average €213. That gap is €768 a year.","yearlyImpactEur":768,"confidence":"medium","billType":null,"evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Restaurants"},"facts":[{"id":"peer:Restaurants:mine","label":"Restaurants, your monthly average","value":276.52,"unit":"EUR/month","source":"bank-data","basis":"40 purchases in the last 12 months","evidence":{"from":"2025-10-01","to":"2026-09-30","category":"Restaurants"}},{"id":"peer:Restaurants:peers","label":"Restaurants, age 18-24 average","value":212.52,"unit":"EUR/month","source":"bank-data","basis":"419 customers in the same age band"},{"id":"peer:Restaurants:gap-yearly","label":"Restaurants, gap per year","value":768,"unit":"EUR/year","source":"calculation","basis":"monthly gap times 12"}],"nextSteps":["get_spending","run_scenario"]},{"id":"overdraft-risk","kind":"overdraft-risk","title":"Below zero in 6 of the last 12 months","detail":"15 payments left the account in the red; the lowest point was €-325.50. Your balance is usually lowest about 25 days after payday.","yearlyImpactEur":null,"confidence":"high","billType":null,"evidence":{"from":"2025-10-01","to":"2026-09-30","negativeBalance":true},"facts":[{"id":"overdraft:months","label":"Months with a balance below zero","value":6,"unit":"count","source":"bank-data","basis":"of the last 12 months","evidence":{"from":"2025-10-01","to":"2026-09-30","negativeBalance":true}},{"id":"overdraft:payments","label":"Payments that left the balance below zero","value":15,"unit":"count","source":"bank-data","basis":"last 12 months","evidence":{"from":"2025-10-01","to":"2026-09-30","negativeBalance":true}},{"id":"overdraft:lowest","label":"Lowest balance","value":-325.5,"unit":"EUR","source":"bank-data","basis":"lowest balance after any payment in the last 12 months","evidence":{"from":"2025-10-01","to":"2026-09-30","negativeBalance":true}},{"id":"overdraft:days-to-low","label":"Days from payday to the lowest balance","value":25,"unit":"days","source":"calculation","basis":"average over the last 12 pay cycles"}],"nextSteps":["get_cash_flow","explain_concept"]},{"id":"payday-spike","kind":"payday-spike","title":"34% of your everyday spending happens in the week after payday","detail":"If spending were spread evenly it would be about 23%. Money that goes early is what runs short at the end of the month.","yearlyImpactEur":null,"confidence":"medium","billType":null,"evidence":{"from":"2025-10-01","to":"2026-09-30","basket":"everyday"},"facts":[{"id":"payday:first-week-share","label":"Share of everyday spending in the week after payday",