es"}],"slices":[{"label":"Entertainment","value":632.33,"share":18.39},{"label":"Housing","value":622.21,"share":18.09},{"label":"Groceries","value":532.77,"share":15.49},{"label":"Restaurants","value":387.04,"share":11.25},{"label":"Invest Deposit","value":293.73,"share":8.54},{"label":"Other","value":971.26,"share":28.24}],"total":3439.34,"centerLabel":"a month"}}

