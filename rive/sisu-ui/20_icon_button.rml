<!-- IconButton  (48x48, fixed)
     A round pressable icon button.

     View model IconButtonVM  (names and types are fixed by rive/contract.json):
       icon        enum IconKind      in     default "settings"   settings | close | back | forward | info | soundOn | soundOff | more
       style       enum IconStyle     in     default "plain"      plain = dark green icon on nothing, tinted = dark green icon on a
                                                                  pale mint circle, filled = white icon on deep green
       enabled     boolean            in     default true
       pressed     trigger            out
       _down       boolean            private  default false

     How it works
       Hit        transparent 48 x 48 shape; all four listeners target it.
       Face       a node holding the 44 pt disc and the icon. Edge is the same disc 4 pt lower: the darker bottom edge.
       Icon       a Solo holding the eight drawings, all stroked 2.2 pt with round ends. AnyState -> one state per `icon` value;
                  the pose keys Solo.activeComponentId.
       Style      AnyState -> plain | tinted | filled (enabled is true and style matches), or `disabled plain` / `disabled solid`
                  (enabled is false). Each pose keys the disc, edge and icon colours. The disabled poses also key Hit.x far away,
                  so taps cannot land. These transitions are instant, so the first frame already shows the right look.
       Press      up <-> down on the private boolean _down (down / up / exit listeners). The face goes down 4 pt and to 94 % and
                  the edge fades out in 80 ms; on release it springs back in 320 ms (elastic), like Button.
       pressed    fired by the click listener: once per completed tap, never while disabled. -->
<Rive version="1" kind="fragment">
    <!-- View model -->
    <ViewModel defaultInstanceId="20:7" name="IconButtonVM" id="20:1">
        <ViewModelPropertyEnumCustom enumId="0:300" name="icon" id="20:2"/>
        <ViewModelPropertyEnumCustom enumId="0:320" name="style" id="20:3"/>
        <ViewModelPropertyBoolean name="enabled" id="20:4"/>
        <ViewModelPropertyTrigger name="pressed" id="20:5"/>
        <!-- private: written by the listeners, read by the state machine. The app does not touch it. -->
        <ViewModelPropertyBoolean name="_down" id="20:6"/>
        <ViewModelInstance exports="true" name="Default" id="20:7">
            <ViewModelInstanceEnum propertyValue="0:301" viewModelPropertyId="20:2" id="20:8"/>  <!-- icon = settings -->
            <ViewModelInstanceEnum propertyValue="0:321" viewModelPropertyId="20:3" id="20:9"/>  <!-- style = plain -->
            <ViewModelInstanceBoolean propertyValue="true" viewModelPropertyId="20:4" id="20:10"/>  <!-- enabled -->
            <ViewModelInstanceTrigger viewModelPropertyId="20:5" id="20:11"/>  <!-- pressed -->
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="20:6" id="20:12"/>  <!-- _down -->
        </ViewModelInstance>
    </ViewModel>

    <Artboard defaultStateMachineId="20:40" viewModelId="20:1" viewModelInstanceId="20:7" clip="true" width="48" height="48"
            x="1600" y="560" styleId="20:14" name="IconButton" id="20:13">
        <LayoutComponentStyle name="Artboard Style" id="20:14"/>

