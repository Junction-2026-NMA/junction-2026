<!-- ChoiceCard  (350x64, flexibleWidth)
     An answer option for a teaching question.

     View model ChoiceCardVM  (names and types are fixed by rive/contract.json):
       label       string             in     default "Invest it"
       state       enum ChoiceState   in     default "idle"
       pressed     trigger            out
       _down       boolean            private  default false

     How it works
       Hit        transparent box over the artboard; the listeners target it.
       State      AnyState -> idle | selected | correct | wrong on `state`. Each pose keys face, outline, edge and label colours.
                  selected = deep green outline and edge. correct = pale mint face with a tick. wrong = neutral grey outline, never red.
       Feedback   a second layer on `state` that plays the motion once: selected = a small pop, correct = the card pops and the
                  tick lands with an overshoot, wrong = a small sideways shake (neutral, never red).
       Press      up <-> down on the private boolean _down: Face.y 0 -> 4, Edge fades out, springs back.
       pressed    fired by the click listener, once per completed tap, in every state. -->
<Rive version="1" kind="fragment">
    <!-- View model -->
    <ViewModel defaultInstanceId="9:6" name="ChoiceCardVM" id="9:1">
        <ViewModelPropertyString name="label" id="9:2"/>
        <ViewModelPropertyEnumCustom enumId="0:180" name="state" id="9:3"/>
        <ViewModelPropertyTrigger name="pressed" id="9:4"/>
        <!-- private: written by the listeners, read by the state machine. The app does not touch these. -->
        <ViewModelPropertyBoolean name="_down" id="9:5"/>
        <ViewModelInstance exports="true" name="Default" id="9:6">
            <ViewModelInstanceString propertyValue="Invest it" viewModelPropertyId="9:2" id="9:7"/>  <!-- label -->
            <ViewModelInstanceEnum propertyValue="0:181" viewModelPropertyId="9:3" id="9:8"/>  <!-- state = idle -->
            <ViewModelInstanceTrigger viewModelPropertyId="9:4" id="9:9"/>  <!-- pressed -->
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="9:5" id="9:10"/>  <!-- _down -->
        </ViewModelInstance>
    </ViewModel>

    <Artboard defaultStateMachineId="9:28" viewModelId="9:1" viewModelInstanceId="9:6" clip="true" width="350" height="64"
            x="1040" y="236" styleId="9:12" name="ChoiceCard" id="9:11">
        <LayoutComponentStyle name="Artboard Style" id="9:12"/>

        <!-- Scene. The first sibling draws on top. -->
        <!-- Transparent hit area over the whole card. -->
        <LayoutComponent clip="false" styleId="9:14" name="Hit" id="9:13">
            <LayoutComponentStyle positionTypeValue="absolute" widthUnitsValue="auto" heightUnitsValue="auto" positionLeft="0"
                    positionLeftUnitsValue="points" positionRight="0" positionRightUnitsValue="points" positionTop="0"
                    positionTopUnitsValue="points" positionBottom="0" positionBottomUnitsValue="points" name="Hit Style" id="9:14"/>
            <Fill name="Fill"><SolidColor colorValue="00FFFFFF" name="Color"/></Fill>
        </LayoutComponent>
        <!-- The face: 60 tall, moves down 4 while pressed. The label wraps to two lines, then ends in an ellipsis. -->
        <LayoutComponent height="60" clip="false" styleId="9:16" name="Face" id="9:15">
            <SemanticData role="button" name="Semantics"><DataBindContext sourcePathIds="9:1-9:2" propertyKey="983"/></SemanticData>  <!-- for VoiceOver: role, label <- the component's text -->
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed" flexDirectionValue="row"
                    layoutAlignmentType="centerLeft" cornerRadiusTL="18" paddingLeft="20" paddingLeftUnitsValue="points"
                    paddingRight="16" paddingRightUnitsValue="points" gapHorizontal="12" gapHorizontalUnitsValue="points"
                    name="Face Style" id="9:16"/>
            <ComponentOrigin originX="0.5" originY="0.5" name="Origin"/>
            <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color" id="9:17"/></Fill>
            <Stroke thickness="2" position="inside" name="Outline"><SolidColor colorValue="FF99D59F" name="Color" id="9:18"/></Stroke>
