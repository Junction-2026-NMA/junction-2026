            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="9:13" listenerTypeValue="click" name="Tap" id="9:32">  <!-- on Hit -->
                <ListenerViewModelChange><BindablePropertyTrigger propertyValue="1"><DataBindContext sourcePathIds="9:1-9:4" propertyKey="686" direction="true"/></BindablePropertyTrigger></ListenerViewModelChange>  <!-- fires pressed -->
            </StateMachineListenerSingle>
            <StateMachineLayer name="State" id="9:33">
                <AnyState x="0" y="-140" id="9:34">
                    <StateTransition stateToId="9:37" duration="160">  <!-- to idle -->
                        <TransitionViewModelCondition>  <!-- state is idle -->
                            <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="9:1-9:3" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="0:181"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="9:38" duration="160">  <!-- to selected -->
                        <TransitionViewModelCondition>  <!-- state is selected -->
                            <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="9:1-9:3" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="0:182"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="9:39" duration="160">  <!-- to correct -->
                        <TransitionViewModelCondition>  <!-- state is correct -->
                            <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="9:1-9:3" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="0:183"/>
