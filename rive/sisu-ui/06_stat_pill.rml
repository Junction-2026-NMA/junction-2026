<!-- StatPill  (96x36, fixed)
     Streak pill (amber flame) or berries pill (pale mint).

     View model StatPillVM  (names and types are fixed by rive/contract.json):
       kind        enum StatKind      in     default "streak"
       value       string             in     default "12"

     How it works
       Pill       hugs its icon and value and is anchored to the left edge of the fixed 96 x 36 artboard.
                  The value shrinks its font past 48 pt wide (a full-width pill).
       Flame      the streak flame flickers in a slow 1.6 s loop (its own layer).
       Kind       AnyState -> streak | berries on `kind`. The pose keys the pill colour, the value colour and which icon the Solo shows.
                  streak = amber background, amber flame. berries = pale mint background, S green berry. -->
<Rive version="1" kind="fragment">
    <!-- View model -->
    <ViewModel defaultInstanceId="6:4" name="StatPillVM" id="6:1">
        <ViewModelPropertyEnumCustom enumId="0:160" name="kind" id="6:2"/>
        <ViewModelPropertyString name="value" id="6:3"/>
        <ViewModelInstance exports="true" name="Default" id="6:4">
            <ViewModelInstanceEnum propertyValue="0:161" viewModelPropertyId="6:2" id="6:5"/>  <!-- kind = streak -->
            <ViewModelInstanceString propertyValue="12" viewModelPropertyId="6:3" id="6:6"/>  <!-- value -->
        </ViewModelInstance>
    </ViewModel>

    <Artboard defaultStateMachineId="6:20" viewModelId="6:1" viewModelInstanceId="6:4" clip="true" width="96" height="36" x="1040"
            y="120" styleId="6:8" name="StatPill" id="6:7">
        <LayoutComponentStyle name="Artboard Style" id="6:8"/>

        <!-- Scene. The first sibling draws on top. -->
        <!-- The pill hugs its icon and value and sits at the artboard's left edge, inside the app's fixed 96 x 36 frame. -->
        <LayoutComponent height="36" clip="true" styleId="6:10" name="Pill" id="6:9">
            <SemanticData role="text" name="Semantics"><DataBindContext sourcePathIds="6:1-6:3" propertyKey="983"/></SemanticData>  <!-- for VoiceOver: role, label <- the component's text -->
            <LayoutComponentStyle layoutWidthScaleType="hug" layoutHeightScaleType="fixed" flexDirectionValue="row"
                    layoutAlignmentType="center" cornerRadiusTL="18" paddingLeft="10" paddingLeftUnitsValue="points" paddingRight="12"
                    paddingRightUnitsValue="points" gapHorizontal="6" gapHorizontalUnitsValue="points" name="Pill Style" id="6:10"/>
            <Fill name="Fill"><SolidColor colorValue="FFFFF1D8" name="Color" id="6:11"/></Fill>
            <LayoutComponent width="18" height="20" clip="false" styleId="6:13" name="Icon Slot" id="6:12">
                <LayoutComponentStyle name="Icon Slot Style" id="6:13"/>
                <Solo x="9" y="10" activeComponentId="6:15" name="Icon" id="6:14">
                    <Node name="Streak: flame" id="6:15">
                        <Shape name="Inner Flame" id="6:30">
                            <PointsPath isClosed="true" name="Inner Flame">
                                <StraightVertex x="0.4" y="-1.2" radius="0.6"/>
                                <CubicDetachedVertex x="3.3" y="5" inRotation="-1.5708" inDistance="2.4" outRotation="1.5708" outDistance="1.9"/>
                                <CubicMirroredVertex x="0" y="8.2" rotation="3.14159" distance="1.9"/>
                                <CubicDetachedVertex x="-3.3" y="5" inRotation="1.5708" inDistance="1.9" outRotation="-1.5708" outDistance="2.4"/>
                            </PointsPath>
                            <Fill name="Fill"><SolidColor colorValue="FFFFF1D8" name="Color"/></Fill>
                        </Shape>
                        <Shape name="Flame" id="6:31">
                            <PointsPath isClosed="true" name="Flame">
                                <StraightVertex x="2" y="-9.6" radius="1"/>
                                <CubicDetachedVertex x="7" y="3" inRotation="-1.85" inDistance="5.6" outRotation="1.5708" outDistance="3.5"/>
                                <CubicMirroredVertex x="0" y="9.5" rotation="3.14159" distance="3.9"/>
                                <CubicDetachedVertex x="-7" y="3.2" inRotation="1.5708" inDistance="3.5" outRotation="-1.5708" outDistance="2.6"/>
                                <StraightVertex x="-5.6" y="-4.4" radius="0.9"/>
                                <StraightVertex x="-2.4" y="-0.6" radius="1"/>
                            </PointsPath>
                            <Fill name="Fill"><SolidColor colorValue="FFCF8300" name="Color"/></Fill>
                        </Shape>
                    </Node>
                    <Node name="Berries: berry" id="6:16">
                        <Shape name="Leaf">
                            <Ellipse width="8" height="4.6" x="2.8" y="-6.6" rotation="-0.6" name="Leaf Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FF004628" name="Color"/></Fill>
                        </Shape>
                        <Shape name="Berry">
                            <Ellipse width="14.5" height="14.5" y="1.6" name="Berry Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FF00AA46" name="Color"/></Fill>
                        </Shape>
                    </Node>
                </Solo>
            </LayoutComponent>
            <Text wrapValue="noWrap" overflowValue="fitFontSize" name="Value" id="6:17">
                <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" maxWidth="48" maxWidthUnitsValue="points" name="Layout"/>
                <TextStylePaint fontSize="16" fontAssetId="0:12" familyName="Figtree" styleName="Bold" name="Value Style" id="6:18">
                    <Fill name="Fill"><SolidColor colorValue="FF885600" name="Color" id="6:19"/></Fill>
                </TextStylePaint>
                <TextValueRun styleId="6:18" text="" name="Run"><DataBindContext sourcePathIds="6:1-6:3" propertyKey="268"/></TextValueRun>  <!-- text <- value -->
            </Text>
        </LayoutComponent>

        <!-- State machine. Declared before the timelines so the editor opens it first. -->
        <StateMachine name="Main" id="6:20">
            <StateMachineLayer name="Kind" id="6:21">
                <AnyState x="0" y="-140" id="6:22">
                    <StateTransition stateToId="6:25">  <!-- to streak -->
                        <TransitionViewModelCondition>  <!-- kind is streak -->
                            <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="6:1-6:2" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="0:161"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="6:26">  <!-- to berries -->
                        <TransitionViewModelCondition>  <!-- kind is berries -->
                            <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="6:1-6:2" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="0:162"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="0" y="-280" id="6:23"/>
                <EntryState x="0" y="0" id="6:24">
                    <StateTransition stateToId="6:25"/>  <!-- starts in streak -->
                </EntryState>
                <AnimationState animationId="6:27" stateName="streak" x="240" y="0" id="6:25"/>
                <AnimationState animationId="6:28" stateName="berries" x="240" y="110" id="6:26"/>
            </StateMachineLayer>
            <!-- The streak flame is alive: one looping state. (It also runs while the berry is shown; the Solo hides the flame then.) -->
            <StateMachineLayer name="Flame" id="6:32">
                <AnyState x="0" y="-140" id="6:33"/>
                <ExitState x="0" y="-280" id="6:34"/>
                <EntryState x="0" y="0" id="6:35">
                    <StateTransition stateToId="6:36"/>  <!-- starts in flicker -->
                </EntryState>
                <AnimationState animationId="6:37" stateName="flicker" x="240" y="0" id="6:36"/>
            </StateMachineLayer>
        </StateMachine>

        <!-- Timelines. Most are one-key poses: the state transitions do the blending. -->
        <LinearAnimation duration="1" name="kind: streak" id="6:27">
            <KeyedObject objectId="6:11"><KeyedProperty property="colorValue"><KeyFrameColor value="FFFFF1D8" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>  <!-- Pill Color -->
            <KeyedObject objectId="6:19"><KeyedProperty property="colorValue"><KeyFrameColor value="FF885600" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>  <!-- Value Color -->
            <KeyedObject objectId="6:14"><KeyedProperty property="activeComponentId"><KeyFrameId value="6:15" frame="0"/></KeyedProperty></KeyedObject>  <!-- Icon -->
        </LinearAnimation>
        <LinearAnimation duration="1" name="kind: berries" id="6:28">
            <KeyedObject objectId="6:11"><KeyedProperty property="colorValue"><KeyFrameColor value="FFD2FCD5" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>  <!-- Pill Color -->
            <KeyedObject objectId="6:19"><KeyedProperty property="colorValue"><KeyFrameColor value="FF004628" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>  <!-- Value Color -->
            <KeyedObject objectId="6:14"><KeyedProperty property="activeComponentId"><KeyFrameId value="6:16" frame="0"/></KeyedProperty></KeyedObject>  <!-- Icon -->
        </LinearAnimation>
        <!-- 1.6 s loop, slow and small: the flame stretches, leans and settles; the inner flame flickers against it. -->
        <LinearAnimation duration="96" loopValue="loop" name="flame: flicker" id="6:37">
            <KeyedObject objectId="6:31">  <!-- Flame -->
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.08" frame="22" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.97" frame="46" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.05" frame="70" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="96" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.96" frame="22" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.03" frame="46" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.98" frame="70" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="96" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.06" frame="24" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.05" frame="50" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.025" frame="74" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="96" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="6:30">  <!-- Inner Flame -->
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.88" frame="18" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.12" frame="40" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.94" frame="64" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="96" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.06" frame="18" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.94" frame="40" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.03" frame="64" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="96" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="y">
                    <KeyFrameDouble value="0" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.6" frame="18" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.5" frame="40" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.3" frame="64" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="96" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>
</Rive>
