<!-- Celebration  (390x844, fill)
     Full-screen big-win moment with confetti.

     View model CelebrationVM  (names and types are fixed by rive/contract.json):
       headline    string             in     default "Jar full."
       detail      string             in     default "€1,000 that's yours to keep."
       fire        trigger            in
       done        trigger            out

     How it works
       Field      the artboard's own fill, S green. The artboard reflows to any size (`fill`).
       Confetti   idle -> fall on `fire`. One 170-frame timeline (2.8 s) drops every piece from above the top edge to 1180 pt
                  below it, each with its own start, sway and spin. When the timeline ends the transition back to idle fires `done`.
                  Two twin states (A, B) play the same timeline, so firing `fire` again mid-fall restarts it; `done` then fires once,
                  at the end of the last fall. The headline pops once at the start of a fall.
       Nothing moves until `fire`: before that the pieces are transparent and above the top edge. -->
<Rive version="1" kind="fragment">
    <!-- View model -->
    <ViewModel defaultInstanceId="14:6" name="CelebrationVM" id="14:1">
        <ViewModelPropertyString name="headline" id="14:2"/>
        <ViewModelPropertyString name="detail" id="14:3"/>
        <ViewModelPropertyTrigger name="fire" id="14:4"/>
        <ViewModelPropertyTrigger name="done" id="14:5"/>
        <ViewModelInstance exports="true" name="Default" id="14:6">
            <ViewModelInstanceString propertyValue="Jar full." viewModelPropertyId="14:2" id="14:7"/>  <!-- headline -->
            <ViewModelInstanceString propertyValue="€1,000 that's yours to keep." viewModelPropertyId="14:3" id="14:8"/>  <!-- detail -->
            <ViewModelInstanceTrigger viewModelPropertyId="14:4" id="14:9"/>  <!-- fire -->
            <ViewModelInstanceTrigger viewModelPropertyId="14:5" id="14:10"/>  <!-- done -->
        </ViewModelInstance>
    </ViewModel>

    <Artboard defaultStateMachineId="14:65" viewModelId="14:1" viewModelInstanceId="14:6" clip="true" width="390" height="844"
