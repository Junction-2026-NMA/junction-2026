<!-- Baskets  (350x220, flexibleWidth)
     The three spending baskets and the savings jar as one illustration: three woven baskets side by side and a jam jar at the end,
     each filled to its share. The darker the green, the more fixed the money. No text: the app writes the labels under it.

     View model BasketsVM  (names and types are fixed by rive/contract.json, the same four numbers as BasketBar):
       fixed       number             in     default 0.5
       curveballs  number             in     default 0.1
       leaks       number             in     default 0.3
       jars        number             in     default 0.1

     How it works
       Layout     a `fill` row of four `fill` cells; each cell centres a fixed 76x204 box that holds the drawing, so the four
                  drawings spread evenly at any width. Every drawing hangs from a node on its ground line (bottom centre).
                  The boxes are drawn at 88 % (about the ground point), which makes a basket 65 pt wide: the four stay
                  apart down to an artboard 280 wide and touch at about 260. The drawings do not shrink with the width.
       Contents   a Rectangle with its origin at the bottom; its height is bound to the share (0..1 -> 0..body height, clamped,
                  eased with a slight overshoot) and it is clipped to the basket body or the glass. 0 shows the basket empty.
       Wobble     each drawing's scaleY is bound to its share through a springy converter and a formula, so a basket squashes
                  and springs back whenever its share changes (see the converters). No trigger, no timeline.
       Jam        the jar's surface is a slab that rides on the level and tilts in a slow loop: the one state of layer Jam. -->
<Rive version="1" kind="fragment">
    <!-- View model -->
    <ViewModel defaultInstanceId="18:6" name="BasketsVM" id="18:1">
        <ViewModelPropertyNumber name="fixed" id="18:2"/>
        <ViewModelPropertyNumber name="curveballs" id="18:3"/>
        <ViewModelPropertyNumber name="leaks" id="18:4"/>
        <ViewModelPropertyNumber name="jars" id="18:5"/>
        <ViewModelInstance exports="true" name="Default" id="18:6">
            <ViewModelInstanceNumber propertyValue="0.5" viewModelPropertyId="18:2" id="18:7"/>  <!-- fixed -->
            <ViewModelInstanceNumber propertyValue="0.1" viewModelPropertyId="18:3" id="18:8"/>  <!-- curveballs -->
            <ViewModelInstanceNumber propertyValue="0.3" viewModelPropertyId="18:4" id="18:9"/>  <!-- leaks -->
            <ViewModelInstanceNumber propertyValue="0.1" viewModelPropertyId="18:5" id="18:10"/>  <!-- jars -->
        </ViewModelInstance>
    </ViewModel>

    <!-- Converters used only by this artboard -->
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0" maxOutput="124" clampLower="true" clampUpper="true"
            name="share to basket height" id="18:20"/>
    <DataConverterGroup name="share to basket height, eased" id="18:21">
        <DataConverterGroupItem converterId="18:20"/>
        <DataConverterGroupItem converterId="0:61"/>  <!-- shared: ease to new value -->
        <DataConverterGroupItem converterId="0:69"/>  <!-- shared: not below 0 -->
    </DataConverterGroup>
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="-4" maxOutput="99" clampLower="true" clampUpper="true"
            name="share to jam height" id="18:22"/>
    <DataConverterGroup name="share to jam height, eased" id="18:23">
        <DataConverterGroupItem converterId="18:22"/>
        <DataConverterGroupItem converterId="0:61"/>  <!-- shared: ease to new value -->
        <DataConverterGroupItem converterId="0:69"/>  <!-- shared: not below 0 -->
    </DataConverterGroup>

    <!-- The wobble. A basket's scaleY is 1 + 0.25 * (springy value - value): when the app writes a new share, the springy copy
         is still at the old one, so the basket is squashed (more in) or stretched (less in) by that much, and it springs back
         to 1 as the copy catches up, swinging past it a few times. Nothing is keyed and nothing has to be triggered. -->
    <DataConverterInterpolator duration="0.9" interpolationType="elastic" name="springy copy of the value" id="18:71">
        <ElasticInterpolator easingValue="easeOut" amplitude="1" period="0.45"/>
    </DataConverterInterpolator>
    <DataConverterFormula name="wobble: fixed" id="18:72">  <!-- 1 + ((springy value - fixed) * 0.25) -->
        <FormulaTokenValue operationValue="1"/>
        <FormulaTokenOperation operationType="0"/>
        <FormulaTokenParenthesisOpen/>
        <FormulaTokenParenthesisOpen/>
        <FormulaTokenInput/>
        <FormulaTokenOperation operationType="1"/>
        <FormulaTokenValue><DataBindContext sourcePathIds="18:1-18:2" propertyKey="777"/></FormulaTokenValue>
        <FormulaTokenParenthesisClose/>
        <FormulaTokenOperation operationType="2"/>
        <FormulaTokenValue operationValue="0.25"/>
        <FormulaTokenParenthesisClose/>
    </DataConverterFormula>
    <DataConverterGroup name="wobble: fixed, springy" id="18:73">
        <DataConverterGroupItem converterId="18:71"/>
        <DataConverterGroupItem converterId="18:72"/>
    </DataConverterGroup>
    <DataConverterFormula name="wobble: curveballs" id="18:74">  <!-- 1 + ((springy value - curveballs) * 0.25) -->
        <FormulaTokenValue operationValue="1"/>
        <FormulaTokenOperation operationType="0"/>
        <FormulaTokenParenthesisOpen/>
        <FormulaTokenParenthesisOpen/>
        <FormulaTokenInput/>
        <FormulaTokenOperation operationType="1"/>
        <FormulaTokenValue><DataBindContext sourcePathIds="18:1-18:3" propertyKey="777"/></FormulaTokenValue>
        <FormulaTokenParenthesisClose/>
        <FormulaTokenOperation operationType="2"/>
        <FormulaTokenValue operationValue="0.25"/>
        <FormulaTokenParenthesisClose/>
    </DataConverterFormula>
    <DataConverterGroup name="wobble: curveballs, springy" id="18:75">
        <DataConverterGroupItem converterId="18:71"/>
        <DataConverterGroupItem converterId="18:74"/>
    </DataConverterGroup>
    <DataConverterFormula name="wobble: leaks" id="18:76">  <!-- 1 + ((springy value - leaks) * 0.25) -->
        <FormulaTokenValue operationValue="1"/>
        <FormulaTokenOperation operationType="0"/>
        <FormulaTokenParenthesisOpen/>
        <FormulaTokenParenthesisOpen/>
        <FormulaTokenInput/>
        <FormulaTokenOperation operationType="1"/>
        <FormulaTokenValue><DataBindContext sourcePathIds="18:1-18:4" propertyKey="777"/></FormulaTokenValue>
        <FormulaTokenParenthesisClose/>
        <FormulaTokenOperation operationType="2"/>
        <FormulaTokenValue operationValue="0.25"/>
        <FormulaTokenParenthesisClose/>
    </DataConverterFormula>
    <DataConverterGroup name="wobble: leaks, springy" id="18:77">
        <DataConverterGroupItem converterId="18:71"/>
        <DataConverterGroupItem converterId="18:76"/>
    </DataConverterGroup>
    <DataConverterFormula name="wobble: jars" id="18:78">  <!-- 1 + ((springy value - jars) * 0.25) -->
        <FormulaTokenValue operationValue="1"/>
        <FormulaTokenOperation operationType="0"/>
        <FormulaTokenParenthesisOpen/>
        <FormulaTokenParenthesisOpen/>
        <FormulaTokenInput/>
        <FormulaTokenOperation operationType="1"/>
        <FormulaTokenValue><DataBindContext sourcePathIds="18:1-18:5" propertyKey="777"/></FormulaTokenValue>
        <FormulaTokenParenthesisClose/>
        <FormulaTokenOperation operationType="2"/>
        <FormulaTokenValue operationValue="0.25"/>
        <FormulaTokenParenthesisClose/>
    </DataConverterFormula>
    <DataConverterGroup name="wobble: jars, springy" id="18:79">
        <DataConverterGroupItem converterId="18:71"/>
        <DataConverterGroupItem converterId="18:78"/>
    </DataConverterGroup>
    <!-- The jam level as a y for the jar's Float node (up is negative; a full jar is covered to the top). -->
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0" maxOutput="-103" clampLower="true" clampUpper="true"
            name="share to jam level" id="18:80"/>
    <DataConverterGroup name="share to jam level, eased" id="18:83">
        <DataConverterGroupItem converterId="18:80"/>
        <DataConverterGroupItem converterId="0:61"/>  <!-- shared: ease to new value -->
    </DataConverterGroup>

