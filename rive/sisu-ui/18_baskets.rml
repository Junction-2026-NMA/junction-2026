                        name="Jars Cell Style" id="18:61"/>
                <LayoutComponent width="76" height="204" scaleX="0.88" scaleY="0.88" clip="false" styleId="18:63" name="Jars Art" id="18:62">
                    <LayoutComponentStyle name="Jars Art Style" id="18:63"/>
                    <ComponentOrigin originX="0.5" originY="0.98" name="Origin"/>
                    <Node x="38" y="200" name="Jam Jar" id="18:64">
                        <DataBindContext sourcePathIds="18:1-18:5" propertyKey="17" converterId="18:79"/>  <!-- scaleY <- the wobble: squashes when its share changes, springs back -->
                        <Shape name="Lid">
                            <Rectangle width="58" height="16" cornerRadiusTL="6" y="-110" name="Lid Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FF00AA46" name="Color"/></Fill>
                        </Shape>
                        <Shape name="Glass Outline">
                            <Rectangle width="68" height="100" cornerRadiusTL="20" y="-50" name="Glass Path"/>
                            <Stroke thickness="4" name="Stroke"><SolidColor colorValue="FF00AA46" name="Color"/></Stroke>
                        </Shape>
                        <!-- Float rides on the jam level; Surface is a slab of jam whose top edge is the visible surface. The idle loop tilts it. -->
                        <Node name="Float" id="18:81">
                            <DataBindContext sourcePathIds="18:1-18:5" propertyKey="14" converterId="18:83"/>  <!-- y <- jars: the jam level -->
                            <ClippingShape sourceId="18:65" name="Clip to glass"/>
                            <Shape y="1.5" name="Surface" id="18:82">
                                <Rectangle width="76" height="12" originX="0.5" originY="0" name="Surface Path"/>
                                <Fill name="Fill"><SolidColor colorValue="FF91FA9B" name="Color"/></Fill>
                            </Shape>
                        </Node>
                        <Shape name="Jam">
                            <Rectangle width="72" height="6.3" originX="0.5" originY="1" name="Jam Path">
                                <DataBindContext sourcePathIds="18:1-18:5" propertyKey="21" converterId="18:23"/>  <!-- height <- jars, 0..1 mapped to the level less 4 pt -->
                            </Rectangle>
                            <Fill name="Fill"><SolidColor colorValue="FF91FA9B" name="Color"/></Fill>
                            <ClippingShape sourceId="18:65" name="Clip to glass"/>
                        </Shape>
                        <Shape name="Glass Mask" id="18:65">
                            <Rectangle width="68" height="100" cornerRadiusTL="20" y="-50" name="Mask Path"/>
                        </Shape>
                        <Shape name="Glass Back">
                            <Rectangle width="68" height="100" cornerRadiusTL="20" y="-50" name="Back Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color"/></Fill>
                        </Shape>
                    </Node>
                </LayoutComponent>
            </LayoutComponent>
        </LayoutComponent>

        <!-- State machine. Declared before the timelines so the editor opens it first. -->
        <StateMachine name="Main" id="18:90">
            <StateMachineLayer name="Jam" id="18:91">
                <AnyState x="0" y="-140" id="18:92"/>
                <ExitState x="0" y="-280" id="18:93"/>
                <EntryState x="0" y="0" id="18:94">
                    <StateTransition stateToId="18:95"/>  <!-- starts in slosh -->
                </EntryState>
                <AnimationState animationId="18:96" stateName="slosh" x="240" y="0" id="18:95"/>
            </StateMachineLayer>
        </StateMachine>

        <!-- Timelines -->
        <!-- 3.6 s loop, slow and small: the jam surface tilts about 2 degrees each way. -->
        <LinearAnimation duration="216" loopValue="loop" name="jam: slosh" id="18:96">
            <KeyedObject objectId="18:82">  <!-- Surface -->
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0.035" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.035" frame="108" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.035" frame="216" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>
</Rive>
