<!-- TabBar  (390x64, flexibleWidth)
     Bottom bar with four tabs: Today, Ask, Jars, Path.

     View model TabBarVM  (names and types are fixed by rive/contract.json):
       selected    number             in     default 0
       tap0        trigger            out
       tap1        trigger            out
       tap2        trigger            out
       tap3        trigger            out
       label0      string             added  default "Today"
       label1      string             added  default "Ask"
       label2      string             added  default "Jars"
       label3      string             added  default "Path"

     How it works
       Bar        white box; four tabs share the width equally and reflow with the artboard.
       Tab n      one layer per tab: off <-> on when `selected` equals n. `on` turns icon and caption dark green.
       Pill       one pale mint pill behind the icons. Its place comes from `selected` through eased flex weights, so it slides
                  to the new tab in 0.6 s with a slight overshoot when the app writes `selected`.
       tap0..3    fired by a click listener on each tab. The file does not change `selected` itself: the app decides and writes it back.
       label0..3  added string properties for the captions, so no copy is hard-coded (defaults Today, Ask, Jars, Path). -->
<Rive version="1" kind="fragment">
    <!-- View model -->
    <ViewModel defaultInstanceId="7:11" name="TabBarVM" id="7:1">
        <ViewModelPropertyNumber name="selected" id="7:2"/>
        <ViewModelPropertyTrigger name="tap0" id="7:3"/>
        <ViewModelPropertyTrigger name="tap1" id="7:4"/>
        <ViewModelPropertyTrigger name="tap2" id="7:5"/>
        <ViewModelPropertyTrigger name="tap3" id="7:6"/>
        <ViewModelPropertyString name="label0" id="7:7"/>
        <ViewModelPropertyString name="label1" id="7:8"/>
        <ViewModelPropertyString name="label2" id="7:9"/>
        <ViewModelPropertyString name="label3" id="7:10"/>
        <ViewModelInstance exports="true" name="Default" id="7:11">
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="7:2" id="7:12"/>  <!-- selected -->
            <ViewModelInstanceTrigger viewModelPropertyId="7:3" id="7:13"/>  <!-- tap0 -->
            <ViewModelInstanceTrigger viewModelPropertyId="7:4" id="7:14"/>  <!-- tap1 -->
            <ViewModelInstanceTrigger viewModelPropertyId="7:5" id="7:15"/>  <!-- tap2 -->
            <ViewModelInstanceTrigger viewModelPropertyId="7:6" id="7:16"/>  <!-- tap3 -->
            <ViewModelInstanceString propertyValue="Today" viewModelPropertyId="7:7" id="7:17"/>  <!-- label0 -->
            <ViewModelInstanceString propertyValue="Ask" viewModelPropertyId="7:8" id="7:18"/>  <!-- label1 -->
            <ViewModelInstanceString propertyValue="Jars" viewModelPropertyId="7:9" id="7:19"/>  <!-- label2 -->
            <ViewModelInstanceString propertyValue="Path" viewModelPropertyId="7:10" id="7:20"/>  <!-- label3 -->
        </ViewModelInstance>
    </ViewModel>

    <!-- Converters used only by this artboard: `selected` (0..3) becomes the flex weights left and right of the sliding pill.
         The bar is 8 eighths wide and tab n is centred at eighth 2n + 1, so the weights are 2n + 1 and 7 - 2n. -->
    <DataConverterRangeMapper minInput="0" maxInput="3" minOutput="1" maxOutput="7" clampLower="true" clampUpper="true"
            name="selected to weight before the pill" id="7:100"/>
    <DataConverterGroup name="selected to weight before the pill, eased" id="7:101">
        <DataConverterGroupItem converterId="7:100"/>
        <DataConverterGroupItem converterId="0:61"/>  <!-- shared: ease to new value -->
        <DataConverterGroupItem converterId="0:69"/>  <!-- shared: not below 0 -->
    </DataConverterGroup>
    <DataConverterRangeMapper minInput="0" maxInput="3" minOutput="7" maxOutput="1" clampLower="true" clampUpper="true"
            name="selected to weight after the pill" id="7:102"/>
    <DataConverterGroup name="selected to weight after the pill, eased" id="7:103">
        <DataConverterGroupItem converterId="7:102"/>
        <DataConverterGroupItem converterId="0:61"/>  <!-- shared: ease to new value -->
        <DataConverterGroupItem converterId="0:69"/>  <!-- shared: not below 0 -->
    </DataConverterGroup>

    <Artboard defaultStateMachineId="7:61" viewModelId="7:1" viewModelInstanceId="7:11" clip="true" width="390" height="64" x="0"
            y="252" styleId="7:22" name="TabBar" id="7:21">
        <LayoutComponentStyle name="Artboard Style" id="7:22"/>

