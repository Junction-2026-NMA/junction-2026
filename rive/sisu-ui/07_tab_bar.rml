            <!-- The selection pill: one pale mint pill that slides between the tabs. Pill Track is pinned over the bar's content
                 area and holds two empty `fill` boxes, Before (weight 2n + 1) and After (weight 7 - 2n), with a zero-width
                 Marker between them: the marker always stands on the centre of tab n, and the pill is a box pinned around it.
                 (The pill is a layout box, not a Shape: a Shape here would draw under the bar's own white fill.)
                 The weights are eased, so the pill glides to the new tab and overshoots a little.
                 Pill Track is the last child, so it draws under the icons; the pill's y puts it exactly behind them.
                 (The two boxes must stay empty: a `fill` box starts from its content's width, which would skew the split.) -->
            <LayoutComponent clip="false" styleId="7:111" name="Pill Track" id="7:110">
                <LayoutComponentStyle positionTypeValue="absolute" widthUnitsValue="auto" heightUnitsValue="auto" positionLeft="8"
                        positionLeftUnitsValue="points" positionRight="8" positionRightUnitsValue="points" positionTop="0"
                        positionTopUnitsValue="points" positionBottom="0" positionBottomUnitsValue="points" flexDirectionValue="row"
                        name="Pill Track Style" id="7:111"/>
                <LayoutComponent clip="false" styleId="7:113" name="Before" id="7:112">
                    <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill" name="Before Style" id="7:113"/>
                    <DataBindContext sourcePathIds="7:1-7:2" propertyKey="706" converterId="7:101"/>  <!-- fractionalWidth <- 2 * selected + 1 -->
                </LayoutComponent>
                <LayoutComponent width="0.1" height="64" clip="false" styleId="7:115" name="Marker" id="7:114">
                    <LayoutComponentStyle name="Marker Style" id="7:115"/>
                    <LayoutComponent width="56" height="30" clip="false" styleId="7:117" name="Pill" id="7:116">
                        <LayoutComponentStyle positionTypeValue="absolute" positionLeft="-28" positionLeftUnitsValue="points"
                                positionTop="8.9" positionTopUnitsValue="points" cornerRadiusTL="15" name="Pill Style" id="7:117"/>
                        <Fill name="Fill"><SolidColor colorValue="FFD2FCD5" name="Color"/></Fill>
                    </LayoutComponent>
                </LayoutComponent>
                <LayoutComponent clip="false" styleId="7:119" name="After" id="7:118">
                    <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill" name="After Style" id="7:119"/>
                    <DataBindContext sourcePathIds="7:1-7:2" propertyKey="706" converterId="7:103"/>  <!-- fractionalWidth <- 7 - 2 * selected -->
                </LayoutComponent>
            </LayoutComponent>
        </LayoutComponent>

        <!-- State machine. Declared before the timelines so the editor opens it first. -->
