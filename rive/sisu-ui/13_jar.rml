            </Shape>
            <!-- Float rides on the jam level (its y is bound to `fill` with the same easing as the jam's height), clipped to the glass.
                 Surface is a slab of jam whose top edge is the visible surface: the idle loop tilts it a little, so the jam looks alive.
                 Three mint berries hang under the surface and bob. With little jam they are below the jar's floor, so they are clipped away. -->
            <Node y="-4" name="Float" id="13:46">
                <DataBindContext sourcePathIds="13:1-13:2" propertyKey="14" converterId="13:44"/>  <!-- y <- fill: the jam level -->
                <ClippingShape sourceId="13:24" name="Clip to glass"/>
                <Node x="-48" y="17" name="Berry 1" id="13:47">
                    <Shape x="3" y="-5" rotation="-0.7" name="Leaf"><Ellipse width="6" height="3.4" name="Leaf Path"/><Fill name="Fill"><SolidColor colorValue="FF004628" name="Color"/></Fill></Shape>
                    <Shape name="Body"><Ellipse width="11" height="11" name="Body Path"/><Fill name="Fill"><SolidColor colorValue="FF91FA9B" name="Color"/></Fill></Shape>
                </Node>
                <Node x="49" y="20" name="Berry 2" id="13:48">
                    <Shape x="3" y="-5" rotation="-0.7" name="Leaf"><Ellipse width="6" height="3.4" name="Leaf Path"/><Fill name="Fill"><SolidColor colorValue="FF004628" name="Color"/></Fill></Shape>
                    <Shape name="Body"><Ellipse width="10" height="10" name="Body Path"/><Fill name="Fill"><SolidColor colorValue="FF91FA9B" name="Color"/></Fill></Shape>
                </Node>
                <Node x="-27" y="33" name="Berry 3" id="13:49">
                    <Shape x="2.6" y="-4.4" rotation="-0.7" name="Leaf"><Ellipse width="5.4" height="3" name="Leaf Path"/><Fill name="Fill"><SolidColor colorValue="FF004628" name="Color"/></Fill></Shape>
                    <Shape name="Body"><Ellipse width="9" height="9" name="Body Path"/><Fill name="Fill"><SolidColor colorValue="FF91FA9B" name="Color"/></Fill></Shape>
                </Node>
                <Shape y="1.5" name="Surface" id="13:50">
                    <Rectangle width="130" height="14" originX="0.5" originY="0" name="Surface Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF00AA46" name="Color"/></Fill>
                </Shape>
            </Node>
            <Shape y="-4" name="Jam">
