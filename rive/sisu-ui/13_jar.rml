            <Fill name="Fill"><SolidColor colorValue="FF00AA46" name="Color"/></Fill>
        </Shape>
        <!-- The jar, drawn from its base (the node sits on the ground line, so the bounce squashes from the bottom).
             Jam is a rectangle growing up from the base; its height is bound to `fill` and it is clipped to the glass. -->
