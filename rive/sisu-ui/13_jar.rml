<!-- Jar  (160x200, contain)
     A savings goal as a jam jar that fills.

     View model JarVM  (names and types are fixed by rive/contract.json):
       fill        number             in     default 0.4
       label       string             in     default "Buffer"
       full        boolean            in     default false
       celebrate   trigger            in

     How it works
       Jam        a Rectangle with its origin at the bottom; its height is bound to `fill` (0..1 -> the level, clamped, eased with
                  a slight overshoot), and a ClippingShape keeps it inside the glass.
       Float      a node whose y is bound to the same level. It carries the Surface slab (the visible top of the jam, which the
                  idle loop tilts a little) and three mint berries that bob under the surface.
       Full       not full <-> full on `full`: the lid turns from dark green to mint.
       Celebrate  idle -> bounce on `celebrate`, back to idle when the timeline ends. The jar squashes and hops, the lid pops off
                  and lands, five sparkles pop.
                  Two twin states (A, B) play the same timeline, so firing `celebrate` again mid-bounce restarts it.
       Label      bound to `label`, centred on the cream label; the font shrinks to fit 74 pt. -->
<Rive version="1" kind="fragment">
    <!-- View model -->
    <ViewModel defaultInstanceId="13:6" name="JarVM" id="13:1">
        <ViewModelPropertyNumber name="fill" id="13:2"/>
        <ViewModelPropertyString name="label" id="13:3"/>
        <ViewModelPropertyBoolean name="full" id="13:4"/>
        <ViewModelPropertyTrigger name="celebrate" id="13:5"/>
        <ViewModelInstance exports="true" name="Default" id="13:6">
            <ViewModelInstanceNumber propertyValue="0.4" viewModelPropertyId="13:2" id="13:7"/>  <!-- fill -->
            <ViewModelInstanceString propertyValue="Buffer" viewModelPropertyId="13:3" id="13:8"/>  <!-- label -->
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="13:4" id="13:9"/>  <!-- full -->
            <ViewModelInstanceTrigger viewModelPropertyId="13:5" id="13:10"/>  <!-- celebrate -->
        </ViewModelInstance>
    </ViewModel>

    <!-- Converters used only by this artboard -->
    <!-- The jam body stops 4 pt under the level: the last few points are the Surface slab, which tilts. -->
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="-4" maxOutput="133" clampLower="true" clampUpper="true"
            name="fill to jam height" id="13:11"/>
    <!-- The level itself, as a y for the Float node (the jar is drawn upwards from its base, so up is negative). -->
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0" maxOutput="-137" clampLower="true" clampUpper="true"
            name="fill to level" id="13:43"/>
    <DataConverterGroup name="fill to level, eased" id="13:44">
        <DataConverterGroupItem converterId="13:43"/>
        <DataConverterGroupItem converterId="0:61"/>  <!-- shared: ease to new value -->
    </DataConverterGroup>
    <DataConverterGroup name="fill to jam height, eased" id="13:12">
        <DataConverterGroupItem converterId="13:11"/>
        <DataConverterGroupItem converterId="0:61"/>  <!-- shared: ease to new value -->
    </DataConverterGroup>

    <Artboard defaultStateMachineId="13:25" viewModelId="13:1" viewModelInstanceId="13:6" clip="true" width="160" height="200"
            x="0" y="572" styleId="13:14" name="Jar" id="13:13">
        <LayoutComponentStyle name="Artboard Style" id="13:14"/>

        <!-- Scene. The first sibling draws on top. -->
        <!-- Sparkles for `celebrate`. They sit outside the Jar node so they do not bounce with it. -->
        <Shape x="20" y="30" scaleX="0" scaleY="0" name="Sparkle 1" id="13:15">
            <Star width="20" height="20" points="4" innerRadius="0.36" cornerRadius="1.2" name="Star"/>
            <Fill name="Fill"><SolidColor colorValue="FF00AA46" name="Color"/></Fill>
        </Shape>
        <Shape x="142" y="22" scaleX="0" scaleY="0" name="Sparkle 2" id="13:16">
            <Star width="16" height="16" points="4" innerRadius="0.36" cornerRadius="1.2" name="Star"/>
            <Fill name="Fill"><SolidColor colorValue="FF91FA9B" name="Color"/></Fill>
