<!-- StageIndicator  (350x72, flexibleWidth)
     Shows the live research stage: searching, reading pages, comparing, done.

     View model StageIndicatorVM  (names and types are fixed by rive/contract.json):
       stage       enum ResearchStage in     default "searching"
       label       string             in     default "Searching for current offers"

     How it works
       Steps      a layout row: four 28 pt steps and three `fill` lines between them, so the row spans any width.
       Stage      AnyState -> searching | reading | comparing | done on `stage`. Each pose keys every dot, tick and line:
                  earlier steps are deep green with a tick, the current step is S green with a pulsing halo (the pose loops),
                  later steps are pale mint with a soft green ring. `done` ticks all four and is still.
       Progress   a second layer on `stage` that plays once per change: the line into the new step fills from the left
                  (a deep green box inside the line, scaled from 0 to 1) and the tick of the step just finished pops.
       Label      bound to `label`; wraps to two lines, then ends in an ellipsis. -->
<Rive version="1" kind="fragment">
    <!-- View model -->
    <ViewModel defaultInstanceId="11:4" name="StageIndicatorVM" id="11:1">
        <ViewModelPropertyEnumCustom enumId="0:220" name="stage" id="11:2"/>
        <ViewModelPropertyString name="label" id="11:3"/>
        <ViewModelInstance exports="true" name="Default" id="11:4">
            <ViewModelInstanceEnum propertyValue="0:221" viewModelPropertyId="11:2" id="11:5"/>  <!-- stage = searching -->
            <ViewModelInstanceString propertyValue="Searching for current offers" viewModelPropertyId="11:3" id="11:6"/>  <!-- label -->
        </ViewModelInstance>
    </ViewModel>

