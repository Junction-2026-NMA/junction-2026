<!-- Liito  (240x240, contain)
     The mascot. Mood follows the user's effort, never their balance.

     View model LiitoVM  (names and types are fixed by rive/contract.json):
       mood        enum LiitoMood     in     default "idle"

     How it works
       Mood       AnyState -> one state per LiitoMood value, 200 ms blend. Each pose keys the same set of things:
                  both arm rotations, the membrane (opacity and its hand point), head tilt, which eyes and mouth show,
                  cheeks, the three think dots and the whole-body offset. Poses that move (cheering, gliding, thinking,
                  cosy, sleepy, found) are loops.
                  Clearly different: idle, cheering (arms up, membrane open), thinking (head tilt, dots), sleepy (eyes closed).
                  proud, gliding, curious, found, focused and cosy are first-pass poses built from the same parts.
       Breath     always-on loop: the root scales a little from the feet.
       Blink      always-on loop: both eyes close for a few frames every 3.3 s. Hidden while the open eyes are hidden. -->
<Rive version="1" kind="fragment">
    <!-- View model -->
    <ViewModel defaultInstanceId="12:3" name="LiitoVM" id="12:1">
        <ViewModelPropertyEnumCustom enumId="0:240" name="mood" id="12:2"/>
        <ViewModelInstance exports="true" name="Default" id="12:3">
            <ViewModelInstanceEnum propertyValue="0:241" viewModelPropertyId="12:2" id="12:4"/>  <!-- mood = idle -->
        </ViewModelInstance>
    </ViewModel>

    <Artboard defaultStateMachineId="12:27" viewModelId="12:1" viewModelInstanceId="12:3" clip="true" width="240" height="240"
