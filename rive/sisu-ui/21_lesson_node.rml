<!-- LessonNode  (120x120, contain)
     One node of the learning path.

     View model LessonNodeVM  (names and types are fixed by rive/contract.json):
       state       enum LessonState   in     default "upcoming"   upcoming | current | done
       number      string             in     default "1"
       pressed     trigger            out
       _down       boolean            private  default false

     How it works
       Hit        transparent 120 x 120 shape; all four listeners target it.
       Node       Bouncer holds the Face (an 84 pt disc with the number or the check) and the Edge, the same disc 4 pt lower.
       State      the look. upcoming = pale mint disc, deep green number. current = deep green disc, white number.
                  done = S green disc, white check instead of the number. The layer starts in the right look (conditional entry)
                  and blends for 160 ms when `state` changes later.
       Life       the motion. rest (upcoming) is still. inviting (current) loops: a ring pulses out slowly and the node hops
                  a little every 2.2 s, which invites a tap. win plays once when `state` goes from current to done: the node
                  dips and pops, the check lands with an overshoot, a ring bursts out and six sparkles fly. A node that
                  goes from upcoming straight to done only pops its check in (check pop). A node that is already done
                  when it appears is `done still`: nothing moves, so a path full of finished lessons opens calmly.
       Press      up <-> down on the private boolean _down: the face goes down 4 pt and the edge fades out in 80 ms, and it
                  springs back in 320 ms (elastic), like Button.
       pressed    fired by the click listener, once per completed tap, in every state. -->
<Rive version="1" kind="fragment">
    <!-- View model -->
    <ViewModel defaultInstanceId="21:6" name="LessonNodeVM" id="21:1">
        <ViewModelPropertyEnumCustom enumId="0:340" name="state" id="21:2"/>
        <ViewModelPropertyString name="number" id="21:3"/>
        <ViewModelPropertyTrigger name="pressed" id="21:4"/>
        <!-- private: written by the listeners, read by the state machine. The app does not touch it. -->
        <ViewModelPropertyBoolean name="_down" id="21:5"/>
        <ViewModelInstance exports="true" name="Default" id="21:6">
            <ViewModelInstanceEnum propertyValue="0:341" viewModelPropertyId="21:2" id="21:7"/>  <!-- state = upcoming -->
            <ViewModelInstanceString propertyValue="1" viewModelPropertyId="21:3" id="21:8"/>  <!-- number -->
            <ViewModelInstanceTrigger viewModelPropertyId="21:4" id="21:9"/>  <!-- pressed -->
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="21:5" id="21:10"/>  <!-- _down -->
        </ViewModelInstance>
    </ViewModel>

    <Artboard defaultStateMachineId="21:40" viewModelId="21:1" viewModelInstanceId="21:6" clip="true" width="120" height="120"
            x="1600" y="660" styleId="21:12" name="LessonNode" id="21:11">
        <LayoutComponentStyle name="Artboard Style" id="21:12"/>

