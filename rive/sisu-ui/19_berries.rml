<!-- Berries  (320x200, contain)
     A pile of round S green berries with tiny dark green leaves in a shallow pale dish: the effort points.

     View model BerriesVM  (names and types are fixed by rive/contract.json):
       count       number             in     default 12     0..60
       drop        trigger            in                    drops one berry onto the pile with a bounce

     How it works
       Pile       20 berries in four rows (7, 6, 4, 3), numbered in the order they appear: from the middle of a row outwards,
                  bottom row first. Berry n has its scale bound to `count` through its own range mapper (0 below its threshold,
                  1 from it), then `pop to new value`, so a berry pops in when `count` passes its threshold and shrinks away
                  when it drops back. Thresholds: one berry per count up to 10, then one more for every 5 (15, 20 ... 60),
                  so small numbers can be counted and big ones still read as "more".
       Drop       idle -> drop on `drop`, back to idle when the timeline ends. Twin states A and B play the same timeline, so
                  firing `drop` again mid-fall restarts it. A spare berry falls from above the artboard onto the pile, squashes,
                  bounces twice and sinks into the pile; the pile squashes under it and the rows jiggle.
                  The landing height follows `count` (the Landing nodes' y are bound), so the berry always lands on top of the pile. -->
<Rive version="1" kind="fragment">
    <!-- View model -->
    <ViewModel defaultInstanceId="19:4" name="BerriesVM" id="19:1">
        <ViewModelPropertyNumber name="count" id="19:2"/>
        <ViewModelPropertyTrigger name="drop" id="19:3"/>
        <ViewModelInstance exports="true" name="Default" id="19:4">
            <ViewModelInstanceNumber propertyValue="12" viewModelPropertyId="19:2" id="19:5"/>  <!-- count -->
            <ViewModelInstanceTrigger viewModelPropertyId="19:3" id="19:6"/>  <!-- drop -->
        </ViewModelInstance>
    </ViewModel>

    <!-- Converters used only by this artboard -->
    <!-- A pop: eases to the new value in 0.4 s and overshoots it slightly on the way. -->
    <DataConverterInterpolator duration="0.4" interpolationType="cubic" name="pop to new value" id="19:20">
        <CubicEaseInterpolator x1="0.34" y1="1.56" x2="0.64" y2="1"/>
    </DataConverterInterpolator>
    <!-- Keeps a scale from going below 0 when a berry shrinks away (the overshoot would flip it for a frame or two). -->
    <DataConverterRangeMapper minInput="0" maxInput="2" minOutput="0" maxOutput="2" clampLower="true" name="not below 0" id="19:21"/>
    <!-- Where a dropped berry lands: the pile gets taller as count grows. -->
    <!-- Where a dropped berry lands. The pile grows a row at counts 1, 8, 30 and 50, so the landing point climbs one row (29 pt)
         at each of them: four nested nodes, each lifted by its own step. -->
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="151" maxOutput="122" clampLower="true" clampUpper="true"
            name="landing: on row 1 from count 1" id="19:22"/>
    <DataConverterGroup name="landing: on row 1 from count 1, eased" id="19:23">
        <DataConverterGroupItem converterId="19:22"/>
        <DataConverterGroupItem converterId="0:61"/>  <!-- shared: ease to new value -->
    </DataConverterGroup>
    <DataConverterRangeMapper minInput="7" maxInput="8" minOutput="0" maxOutput="-29" clampLower="true" clampUpper="true"
            name="landing: on row 2 from count 8" id="19:24"/>
    <DataConverterGroup name="landing: on row 2 from count 8, eased" id="19:25">
        <DataConverterGroupItem converterId="19:24"/>
        <DataConverterGroupItem converterId="0:61"/>
    </DataConverterGroup>
    <DataConverterRangeMapper minInput="29" maxInput="30" minOutput="0" maxOutput="-29" clampLower="true" clampUpper="true"
            name="landing: on row 3 from count 30" id="19:26"/>
    <DataConverterGroup name="landing: on row 3 from count 30, eased" id="19:27">
        <DataConverterGroupItem converterId="19:26"/>
        <DataConverterGroupItem converterId="0:61"/>
    </DataConverterGroup>
    <DataConverterRangeMapper minInput="49" maxInput="50" minOutput="0" maxOutput="-29" clampLower="true" clampUpper="true"
            name="landing: on row 4 from count 50" id="19:28"/>
    <DataConverterGroup name="landing: on row 4 from count 50, eased" id="19:29">
        <DataConverterGroupItem converterId="19:28"/>
