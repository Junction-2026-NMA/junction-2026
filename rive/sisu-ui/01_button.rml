            <StateMachineListenerSingle targetId="1:17" listenerTypeValue="up" name="Pointer up" id="1:42">  <!-- on Hit -->
                <ListenerViewModelChange><BindablePropertyBoolean propertyValue="false"><DataBindContext sourcePathIds="1:1-1:7" propertyKey="634" direction="true"/></BindablePropertyBoolean></ListenerViewModelChange>  <!-- _down = false -->
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="1:17" listenerTypeValue="exit" name="Pointer exit" id="1:43">  <!-- on Hit -->
                <ListenerViewModelChange><BindablePropertyBoolean propertyValue="false"><DataBindContext sourcePathIds="1:1-1:7" propertyKey="634" direction="true"/></BindablePropertyBoolean></ListenerViewModelChange>  <!-- _down = false -->
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="1:17" listenerTypeValue="click" name="Tap" id="1:44">  <!-- on Hit -->
                <ListenerViewModelChange><BindablePropertyTrigger propertyValue="1"><DataBindContext sourcePathIds="1:1-1:6" propertyKey="686" direction="true"/></BindablePropertyTrigger></ListenerViewModelChange>  <!-- fires pressed -->
            </StateMachineListenerSingle>
            <StateMachineLayer name="Style" id="1:45">
                <AnyState x="0" y="-140" id="1:46">
                    <StateTransition stateToId="1:49">  <!-- to primary -->
                        <TransitionViewModelCondition>  <!-- enabled is true -->
                            <TransitionPropertyViewModelComparator><BindablePropertyBoolean><DataBindContext sourcePathIds="1:1-1:4" propertyKey="634"/></BindablePropertyBoolean></TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                        <TransitionViewModelCondition>  <!-- style is primary -->
                            <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="1:1-1:3" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="0:101"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="1:50">  <!-- to secondary -->
                        <TransitionViewModelCondition>  <!-- enabled is true -->
                            <TransitionPropertyViewModelComparator><BindablePropertyBoolean><DataBindContext sourcePathIds="1:1-1:4" propertyKey="634"/></BindablePropertyBoolean></TransitionPropertyViewModelComparator>
