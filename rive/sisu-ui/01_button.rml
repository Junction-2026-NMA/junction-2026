<!-- Button  (350x60, flexibleWidth)
     The pressable button. Face moves down 4 and the edge hides while pressed.

     View model ButtonVM  (names and types are fixed by rive/contract.json):
       label       string             in     default "Continue"
       style       enum ButtonStyle   in     default "primary"
       enabled     boolean            in     default true
       loading     boolean            in     default false
       pressed     trigger            out
       _down       boolean            private  default false

     How it works
       Hit        transparent box over the artboard; all four listeners target it.
       Style      AnyState -> primary | secondary | onDark | quiet (enabled is true and style matches) or disabled (enabled is false).
                  Each pose keys the colours. `disabled` also keys Hit.x far away, so taps cannot land.
                  These transitions are instant, so the first frame already shows the right look.
       Press      up <-> down on the private boolean _down (down / up / exit listeners). Face.y 0 -> 4, Edge fades out, springs back.
       Loading    idle <-> loading on `loading`. Hides the label, shows three bouncing dots, keys Hit.y far away.
       pressed    fired by the click listener: once per completed tap, never while disabled or loading. -->
<Rive version="1" kind="fragment">
    <!-- View model -->
    <ViewModel defaultInstanceId="1:8" name="ButtonVM" id="1:1">
        <ViewModelPropertyString name="label" id="1:2"/>
        <ViewModelPropertyEnumCustom enumId="0:100" name="style" id="1:3"/>
        <ViewModelPropertyBoolean name="enabled" id="1:4"/>
        <ViewModelPropertyBoolean name="loading" id="1:5"/>
        <ViewModelPropertyTrigger name="pressed" id="1:6"/>
        <!-- private: written by the listeners, read by the state machine. The app does not touch these. -->
        <ViewModelPropertyBoolean name="_down" id="1:7"/>
        <ViewModelInstance exports="true" name="Default" id="1:8">
            <ViewModelInstanceString propertyValue="Continue" viewModelPropertyId="1:2" id="1:9"/>  <!-- label -->
            <ViewModelInstanceEnum propertyValue="0:101" viewModelPropertyId="1:3" id="1:10"/>  <!-- style = primary -->
            <ViewModelInstanceBoolean propertyValue="true" viewModelPropertyId="1:4" id="1:11"/>  <!-- enabled -->
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="1:5" id="1:12"/>  <!-- loading -->
            <ViewModelInstanceTrigger viewModelPropertyId="1:6" id="1:13"/>  <!-- pressed -->
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="1:7" id="1:14"/>  <!-- _down -->
        </ViewModelInstance>
    </ViewModel>

    <Artboard defaultStateMachineId="1:40" viewModelId="1:1" viewModelInstanceId="1:8" clip="true" width="350" height="60" x="0"
            y="0" styleId="1:16" name="Button" id="1:15">
        <LayoutComponentStyle name="Artboard Style" id="1:16"/>

        <!-- Scene. The first sibling draws on top. -->
        <!-- Transparent hit area. The disabled and loading poses slide it off the artboard, so no listener can fire. -->
        <LayoutComponent clip="false" styleId="1:18" name="Hit" id="1:17">
            <LayoutComponentStyle positionTypeValue="absolute" widthUnitsValue="auto" heightUnitsValue="auto" positionLeft="0"
                    positionLeftUnitsValue="points" positionRight="0" positionRightUnitsValue="points" positionTop="0"
                    positionTopUnitsValue="points" positionBottom="0" positionBottomUnitsValue="points" name="Hit Style" id="1:18"/>
            <Fill name="Fill"><SolidColor colorValue="00FFFFFF" name="Color"/></Fill>
        </LayoutComponent>
        <!-- The face: 56 tall, moves down 4 while pressed. The label hugs its text (shrinks if too long); the dots sit in a box pinned over the face. -->
        <LayoutComponent height="56" clip="false" styleId="1:20" name="Face" id="1:19">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed" flexDirectionValue="row"
                    layoutAlignmentType="center" cornerRadiusTL="18" paddingLeft="16" paddingLeftUnitsValue="points"
                    paddingRight="16" paddingRightUnitsValue="points" name="Face Style" id="1:20"/>
            <Fill name="Fill"><SolidColor colorValue="FF007841" name="Color" id="1:21"/></Fill>
            <Stroke thickness="2" position="inside" name="Outline"><SolidColor colorValue="0099D59F" name="Color" id="1:22"/></Stroke>
            <Text wrapValue="noWrap" overflowValue="fitFontSize" name="Label" id="1:23">
                <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" maxWidth="100" maxWidthUnitsValue="percent" name="Layout"/>
