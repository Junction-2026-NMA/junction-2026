{
  "version": 1,
  "note": "The contract between the Rive files and the Swift app. Artboard, view model, property and enum names are fixed: the Swift app binds to them by name. Visuals may change freely; names, types and meanings may not.",
  "rules": {
    "stateMachine": "Every artboard has one state machine named Main, set as the artboard's default.",
    "viewModel": "Every artboard has its own view model named <Artboard>VM with a default instance, set as the artboard's default view model.",
    "direction": "in = the app writes it. out = the Rive file fires or writes it and the app listens. inout = both.",
    "text": "All visible text comes from string properties. No hard-coded copy in the file.",
    "colors": "Only the palette in ios/BRAND.md. No other hues.",
    "private": "Properties whose name starts with an underscore (for example _down) belong to the Rive file. The app never reads or writes them."
  },
  "enums": {
    "ButtonStyle": [
      "primary",
      "secondary",
      "onDark",
      "quiet"
    ],
    "Basket": [
      "fixed",
      "curveballs",
      "leaks",
      "jars"
    ],
    "ProgressTone": [
      "green",
      "streak"
    ],
    "StatKind": [
      "streak",
      "berries"
    ],
    "ChoiceState": [
      "idle",
      "selected",
      "correct",
      "wrong"
    ],
    "VoiceState": [
      "idle",
      "recording",
      "thinking",
      "speaking"
    ],
    "ResearchStage": [
      "searching",
      "reading",
      "comparing",
      "done"
    ],
    "LiitoMood": [
      "idle",
      "cheering",
      "proud",
      "gliding",
      "curious",
      "found",
      "focused",
      "cosy",
      "sleepy",
      "thinking"
    ],
    "StickerKind": [
      "firstJar",
      "leakPlugged",
      "streak",
      "lesson"
    ],
    "TagTone": [
      "neutral",
      "amber",
      "info"
    ]
  },
  "files": {
    "sisu_ui": {
      "source": "rive/sisu-ui",
      "output": "ios/Sisu/Resources/Rive/sisu_ui.riv",
      "scripts": false,
      "signed": false,
